#!/usr/bin/env python3
"""Ask the Namecheap cPanel to build a full account backup and send it to the new VPS over SCP.

    VPS_PASSWORD=... bin/migrate-namecheap-backup 187.127.141.173 /root/migration/namecheap

Reads only on the cPanel side (a backup copies the account). The password goes in a POST body,
never in a URL, so it does not land in cPanel's access logs.
"""
import os
import sys
from pathlib import Path
from urllib.parse import urlparse

import requests

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "src"))
from rep.cpanel import CpanelClient  # noqa: E402

host, directory = sys.argv[1], sys.argv[2]
cp_host = os.environ["CPANEL_HOST"].strip()
if cp_host.startswith("https://"):
    cp_host = urlparse(cp_host).hostname
client = CpanelClient(cp_host, os.environ["CPANEL_USER"], os.environ["CPANEL_API_TOKEN"], dry_run=False)
resp = requests.post(f"{client.base}/execute/Backup/fullbackup_to_scp_with_password", headers=client._headers, timeout=60,
                     data={"host": host, "port": "22", "username": "root", "password": os.environ["VPS_PASSWORD"],
                           "directory": directory, "variant": "active"})
body = resp.json()
if not body.get("status"):
    raise SystemExit(f"cPanel refused the backup: {body.get('errors')}")
print("Backup queued on cPanel; it will arrive at", f"{host}:{directory}", body.get("data") or "")
