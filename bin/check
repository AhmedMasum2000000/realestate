#!/usr/bin/env python3
"""Preflight: prove the config and credentials work before touching anything.

    bin/check

Reads config/sites.yml and config/.env, then makes read-only calls to cPanel
and SSH. Nothing is created, changed or deleted.
"""

from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))

from rep.cli import banner, load_all_or_die, make_clients  # noqa: E402
from rep.cpanel import CpanelError  # noqa: E402
from rep.listings import load_csv  # noqa: E402
from rep.ssh import HAVE_PARAMIKO, SshError  # noqa: E402


def main() -> int:
    sites, hosts, env = load_all_or_die()
    problems: list[str] = []

    banner("1. Config")
    print(f"  [+] config/sites.yml parsed -- {len(sites)} sites across {len(hosts)} host(s)")
    for site in sites:
        print(f"      - {site.domain:26} state={site.state:5} host={site.host}")

    account_domains: set[str] = set()

    for name, host in hosts.items():
        used_by = [s for s in sites if s.host == name]
        if not used_by:
            continue

        banner(f"2. Host: {name} ({host.kind}) -- {len(used_by)} site(s)")

        ssh_host = host.ssh_host or host.env_key("SSH_HOST", env)
        ssh_user = host.ssh_user or host.env_key("SSH_USER", env)
        key = host.env_key("SSH_KEY_PATH", env)
        password = host.env_key("SSH_PASSWORD", env)

        if not ssh_host or not ssh_user:
            print(f"  [!] SSH: set ssh_host/ssh_user in sites.yml, or "
                  f"SSH_HOST_{name.upper()} / SSH_USER_{name.upper()} in config/.env")
            problems.append(f"host {name}: SSH connection details missing")
            continue

        auth = "key" if key else "password" if password else "NONE"
        print(f"  [+] SSH: {ssh_user}@{ssh_host}:{host.ssh_port} (auth: {auth})")
        if auth == "NONE":
            problems.append(f"host {name}: neither SSH_KEY_PATH nor SSH_PASSWORD set")
            continue

        if host.kind == "ssh":
            print("  [.] no control panel on this host -- domains and databases")
            print("      cannot be created here; everything else still runs")
        elif not host.env_key("CPANEL_API_TOKEN", env):
            print(f"  [!] cPanel: no API token. Set CPANEL_API_TOKEN_{name.upper()} "
                  f"(or CPANEL_API_TOKEN) in config/.env")
            problems.append(f"host {name}: cPanel API token missing")

        try:
            cp, runner = make_clients(host, env, dry_run=False)
        except SystemExit:
            problems.append(f"host {name}: could not build a connection")
            continue

        if cp is not None:
            try:
                data = cp.list_domains()
                account_domains |= cp.all_domains()
                print(f"  [+] cPanel reachable. main domain: {data.get('main_domain')}")
                print(f"      {len(account_domains)} domains on this account")
            except CpanelError as exc:
                print(f"  [!] cPanel: {exc}")
                problems.append(f"host {name}: cannot reach cPanel")

        try:
            with runner:
                home = runner.run("pwd").check().stdout.strip()
                print(f"  [+] SSH connected. home: {home}")
                wp = runner.run("command -v wp")
                if wp.ok:
                    version = runner.run("wp --version --allow-root").stdout.strip()
                    print(f"  [+] WP-CLI present: {version or wp.stdout.strip()}")
                else:
                    print("  [.] WP-CLI not on PATH -- provision will install it to ~/bin")
        except SshError as exc:
            print(f"  [!] SSH: {exc}")
            problems.append(f"host {name}: cannot connect over SSH")

    banner("3. Per-site readiness")
    for site in sites:
        flags: list[str] = []
        on_account = site.domain in account_domains if account_domains else None
        if on_account is True:
            flags.append("on cPanel")
        elif on_account is False:
            flags.append("NOT on cPanel")
            if site.state == "live":
                problems.append(f"{site.domain} is marked live but is not on this account")

        logo = site.brand.logo_path()
        if logo:
            flags.append(f"logo {'ok' if logo.exists() else 'MISSING'}")

        csv_path = site.listings.csv_path()
        if csv_path and csv_path.exists():
            try:
                rows, mapping = load_csv(csv_path, overrides=site.listings.columns)
                flags.append(f"csv {len(rows)} rows, {len(mapping.mapped)} cols mapped")
                if not mapping.looks_like_listings:
                    problems.append(f"{site.domain}: {csv_path.name} may not be a listings export")
            except (ValueError, OSError) as exc:
                flags.append(f"csv ERROR: {exc}")
                problems.append(f"{site.domain}: cannot read {csv_path.name}")
        elif csv_path:
            flags.append("csv MISSING")
            problems.append(f"{site.domain}: {csv_path} not found")

        print(f"  {site.domain:26} {' | '.join(flags) if flags else '(nothing configured yet)'}")

    banner("Summary")
    if problems:
        for p in problems:
            print(f"  [!] {p}")
        print(f"\n  {len(problems)} thing(s) to fix before provisioning.\n")
        return 1
    print("  [+] All checks passed. Next: bin/provision <domain>\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
