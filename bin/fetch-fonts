#!/usr/bin/env python3
"""Download the display and body faces and emit a local @font-face sheet.

    bin/fetch-fonts

Self-hosting rather than linking Google Fonts removes a third-party request
from the critical path, keeps the site working if that host is blocked or slow,
and stops the page shifting when the webfont arrives late. Only the latin
subset is kept — the site has no Vietnamese or Cyrillic copy.

Writes assets/brand/fonts/ and assets/brand/fonts.css, both committed.
"""

import re
import sys
import urllib.request
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
OUT = ROOT / "assets" / "brand" / "fonts"

QUERY = (
    "https://fonts.googleapis.com/css2"
    "?family=Archivo:wght@600;700;800"
    "&family=Rubik:wght@300;400;500"
    "&display=swap"
)
# Ask as a modern browser or Google serves legacy truetype instead of woff2.
UA = ("Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 "
      "(KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36")

BLOCK = re.compile(r"/\*\s*(?P<subset>[\w-]+)\s*\*/\s*(?P<body>@font-face\s*\{[^}]*\})", re.S)
SRC = re.compile(r"url\((?P<url>https://fonts\.gstatic\.com/[^)]+)\)")
PROP = re.compile(r"(font-family|font-style|font-weight|font-stretch):\s*([^;]+);")


def get(url: str) -> bytes:
    request = urllib.request.Request(url, headers={"User-Agent": UA})
    with urllib.request.urlopen(request, timeout=45) as response:
        return response.read()


def main() -> int:
    OUT.mkdir(parents=True, exist_ok=True)
    sheet = get(QUERY).decode("utf-8")

    faces = []
    for match in BLOCK.finditer(sheet):
        if match.group("subset") != "latin":
            continue  # no Vietnamese, Greek or Cyrillic copy on this site
        body = match.group("body")
        src = SRC.search(body)
        if not src:
            continue

        props = dict((k, v.strip()) for k, v in PROP.findall(body))
        family = props.get("font-family", "").strip("'\"")
        weight = props.get("font-weight", "400")
        name = f"{family.lower()}-{weight}.woff2"

        target = OUT / name
        if not target.exists():
            target.write_bytes(get(src.group("url")))
        print(f"  {name:22s} {target.stat().st_size // 1024}KB")

        faces.append(
            "@font-face{"
            f"font-family:'{family}';"
            f"font-style:{props.get('font-style', 'normal')};"
            f"font-weight:{weight};"
            "font-display:swap;"
            f"src:url(fonts/{name}) format('woff2');"
            "}"
        )

    if not faces:
        print("error: no latin faces found", file=sys.stderr)
        return 1

    (ROOT / "assets" / "brand" / "fonts.css").write_text(
        "/* Generated by bin/fetch-fonts. Latin subset only. */\n"
        + "\n".join(sorted(faces)) + "\n",
        encoding="utf-8",
    )
    print(f"{len(faces)} faces -> assets/brand/fonts.css")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
