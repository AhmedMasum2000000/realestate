#!/bin/bash
# Deploy property data to site/index.html
# Usage: bin/deploy-properties

set -e

cd "$(dirname "$0")/.."

echo "Generating property data from CSV..."
python src/import_properties.py data/properties.csv > /tmp/properties.js

echo "Extracting property array from generated code..."
grep -A 500 "^const P = " /tmp/properties.js | grep -B 500 "^];" > /tmp/prop_data.txt

echo "Backing up current index.html..."
cp site/index.html site/index.html.bak

echo "Updating site/index.html with new property data..."
# Find the line with "const P = [" and replace until the closing "];"
python3 << 'EOPYTHON'
import re

# Read the HTML file
with open('site/index.html', 'r') as f:
    html = f.read()

# Read the generated property code
with open('/tmp/properties.js', 'r') as f:
    gen_code = f.read()

# Extract just the const P = [...] part
match = re.search(r'(const P = \[[\s\S]*?\];)', gen_code)
if match:
    new_prop_code = match.group(1)

    # Replace in the HTML
    html = re.sub(
        r'const P = \[[\s\S]*?\];',
        new_prop_code,
        html,
        count=1
    )

    # Write back
    with open('site/index.html', 'w') as f:
        f.write(html)
    print("✓ Property data updated in site/index.html")
else:
    print("ERROR: Could not extract property data")
    exit(1)
EOPYTHON

echo "Done! Properties deployed to site/index.html"
echo "Backup saved to site/index.html.bak"
