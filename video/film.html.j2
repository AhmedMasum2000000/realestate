{% from 'boon.html.j2' import boon %}{% from 'logo.html.j2' import logo %}{% macro plane(body, line, accent) %}<svg viewBox="0 0 200 200" width="100%" height="100%"><g stroke="{{ line }}" stroke-width="2.4" stroke-linejoin="round" fill="{{ body }}"><path d="M88 80 18 119v10l70-15zM112 80l70 39v10l-70-15zM90 160l-24 17v7l26-8zM110 160l24 17v7l-26-8z"/><rect x="47" y="100" width="11" height="24" rx="5"/><rect x="142" y="100" width="11" height="24" rx="5"/><path d="M100 8c9 0 13 15 13 32v110c0 20-6 35-13 42-7-7-13-22-13-42V40c0-17 4-32 13-32z"/></g><path d="M100 46v100" stroke="{{ accent }}" stroke-width="4"/><path d="M94 27q6-8 12 0l-1 7H95z" fill="{{ accent }}"/></svg>{% endmacro %}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Second Home Thailand · The Door Opens</title>
<style>
@font-face{font-family:Anton;src:url(fonts/anton-latin-400-normal.woff2) format('woff2')}
@font-face{font-family:Inter;src:url(fonts/inter-latin-500-normal.woff2) format('woff2');font-weight:500}
@font-face{font-family:'Martian Mono';src:url(fonts/martian-mono-latin-400-normal.woff2) format('woff2')}
:root{--cream:#e7e2d8;--ink:#171717;--blue:#4a90c2;--paper:#fffdf8;--sea:#14202d;--W:{{ W }}px;--H:{{ H }}px}
*{box-sizing:border-box;margin:0;padding:0}
html,body{width:var(--W);height:var(--H);overflow:hidden;background:#000}
body{font-family:Inter,sans-serif;color:var(--ink);-webkit-font-smoothing:antialiased}
.stage{position:relative;width:var(--W);height:var(--H);overflow:hidden;background:var(--ink)}
.scene{position:absolute;inset:0;overflow:hidden;visibility:hidden}
.abs{position:absolute}
.anton{font-family:Anton,sans-serif;text-transform:uppercase;letter-spacing:-.03em;line-height:.9;font-weight:400}
.serif{font-family:'Iowan Old Style','Palatino Linotype',Palatino,Georgia,serif;font-style:italic;font-weight:400;letter-spacing:-.01em}
.mono{font-family:'Martian Mono',monospace;text-transform:uppercase;letter-spacing:.2em;font-size:15px}
.w{display:inline-block;will-change:transform}
.mask{display:inline-block;overflow:hidden;vertical-align:top;padding:.08em .06em .02em;margin:-.08em -.06em -.02em}
.mask+.mask{margin-left:30px}
.center{left:0;right:0;text-align:center}
svg{display:block}
/* flight */
#flight{background:var(--sea)}
.cloud{position:absolute;background:radial-gradient(circle at 28% 62%,var(--cream) 0 26%,transparent 26.5%),radial-gradient(circle at 50% 42%,var(--cream) 0 32%,transparent 32.5%),radial-gradient(circle at 72% 60%,var(--cream) 0 24%,transparent 24.5%),radial-gradient(ellipse 46% 22% at 50% 74%,var(--cream) 0 99%,transparent 100%)}
.wave{position:absolute;height:3px;background:rgba(74,144,194,.35);border-radius:2px}
/* door */
#door,#meet,#system,#homes,#writing,#logo-scene{background:var(--cream)}
#routes,#montage{background:var(--ink)}
.node{position:absolute;width:190px;height:150px;margin:-75px 0 0 -95px;background:var(--paper);border:2.5px solid var(--ink);display:grid;place-items:center;align-content:center;gap:12px}
.node svg{width:54px;height:54px}
.node .mono{font-size:14px;letter-spacing:.16em;color:var(--ink)}
.tile{position:absolute;width:360px;height:420px;background:var(--cream);border:2.5px solid var(--cream);padding:30px;display:flex;flex-direction:column;justify-content:space-between;transform-origin:50% 0}
.tile .num{font-family:Anton;font-size:190px;line-height:.82;color:var(--blue);letter-spacing:-.04em}
.tile .num small{font-family:'Martian Mono';font-size:16px;letter-spacing:.2em;color:var(--ink);margin-left:10px;vertical-align:top}
.tile h3{font-family:Anton;font-size:46px;line-height:.92;text-transform:uppercase;font-weight:400;letter-spacing:-.02em}
.tile p{font-family:'Martian Mono';font-size:14px;letter-spacing:.16em;text-transform:uppercase;color:rgba(23,23,23,.6);margin-top:10px}
.browser{position:absolute;background:var(--paper);border:2.5px solid var(--ink);overflow:hidden}
.browser-bar{position:relative;z-index:2;height:52px;border-bottom:2px solid var(--ink);display:flex;align-items:center;gap:10px;padding:0 18px;background:var(--cream)}
.browser-bar i{width:13px;height:13px;border:2px solid var(--ink);border-radius:50%}
.browser-bar span{margin-left:16px}
.doc{position:absolute;width:560px;background:var(--paper);border:2.5px solid var(--ink);padding:46px 50px}
.doc-row{display:flex;align-items:center;gap:22px;padding:22px 0;border-bottom:1.5px solid rgba(23,23,23,.16);font-family:Anton;font-size:44px;text-transform:uppercase;letter-spacing:-.01em}
.doc-row svg{width:40px;height:40px;flex:none}
.stamp{position:absolute;border:6px solid var(--blue);color:var(--blue);padding:18px 30px;font-family:Anton;font-size:58px;letter-spacing:.02em;text-transform:uppercase;line-height:1;text-align:center}
.btn{display:inline-flex;align-items:center;gap:26px;background:var(--ink);color:var(--cream);font-family:'Martian Mono';text-transform:uppercase;letter-spacing:.2em;font-size:28px;padding:34px 52px}
</style>
</head>
<body>
<div class="stage" id="stage">

<!-- 1 · The line -->
<section class="scene" id="line"><div class="abs" id="line-bar" style="left:50%;top:50%;height:8px;background:var(--blue);transform-origin:50% 50%"></div></section>

<!-- 2 · Flight over the Gulf at dusk -->
<section class="scene" id="flight">
  <div class="abs" id="sun" style="width:1400px;height:1400px;border-radius:50%;background:radial-gradient(circle,rgba(255,170,96,.42),rgba(255,140,80,.12) 45%,transparent 70%)"></div>
  <div id="waves"></div>
  <div id="clouds-low"></div>
  <div class="abs" id="plane-shadow" style="width:520px;height:520px;opacity:.28">{{ plane('#000', '#000', '#000') }}</div>
  <div class="abs" id="plane" style="width:520px;height:520px">{{ plane('#fffdf8', '#171717', '#4a90c2') }}</div>
  <div id="clouds-high"></div>
  <div class="abs center" id="flight-title" style="color:var(--paper)">
    <div class="mask"><span class="w anton" style="font-size:{{ 150 if not V else 140 }}px" data-w="0">Remember</span></div><br>
    <div class="mask"><span class="w serif" style="font-size:{{ 112 if not V else 96 }}px;line-height:1.05" data-w="1">the warm</span></div><br>
    <div class="mask"><span class="w anton" style="font-size:{{ 150 if not V else 140 }}px;color:#f3c08a" data-w="2">air</span></div>
  </div>
</section>

<!-- 3 · The door opens -->
<section class="scene" id="door">
  <img class="abs" id="door-photo" src="img/summit.jpg" style="inset:0;width:100%;height:100%;object-fit:cover">
  <div class="abs" id="door-warm" style="inset:0;background:radial-gradient(60% 60% at 50% 55%,rgba(255,176,98,.75),rgba(255,140,70,.2) 60%,transparent 85%)"></div>
  <svg class="abs" id="door-svg" width="{{ W }}" height="{{ H }}" viewBox="0 0 {{ W }} {{ H }}" style="inset:0">
    <defs><clipPath id="door-clip"><path d="{{ door_fill }}"/></clipPath></defs>
    <g id="door-g">
      <path fill="#e7e2d8" fill-rule="evenodd" d="M-40000 -40000H40000V40000H-40000Z {{ door_fill }}"/>
      <g clip-path="url(#door-clip)">
        <rect id="leaf-l" x="704" y="500" width="320" height="1000" fill="#171717"/>
        <rect id="leaf-r" x="1024" y="500" width="320" height="1000" fill="#171717"/>
        <path id="leaf-seam" d="M1024 560V1489" stroke="#e7e2d8" stroke-width="6"/>
      </g>
      <g fill="none" stroke-width="68" stroke-miterlimit="3"><path stroke="#171717" d="{{ door_path }}"/><path stroke="#4a90c2" d="M461 1539H654M754 1539H1294M1394 1539H1587"/></g>
    </g>
  </svg>
  <div class="abs center" id="door-text" style="bottom:{{ 70 if not V else 230 }}px"><span class="serif" style="font-size:{{ 64 if not V else 60 }}px">…when the door opened?</span></div>
</section>

<!-- 4 · Imagine it every morning -->
<section class="scene" id="summit">
  <img class="abs" id="summit-photo" src="img/summit.jpg" style="inset:0;width:100%;height:100%;object-fit:cover;transform-origin:44% 40%">
  <canvas class="abs" id="embers" width="{{ W }}" height="{{ H }}" style="inset:0;mix-blend-mode:screen"></canvas>
  <div class="abs" style="inset:0;background:linear-gradient(180deg,rgba(18,12,8,.35),rgba(18,12,8,0) 30%,rgba(18,12,8,.15) 55%,rgba(18,12,8,.75))"></div>
  <div class="abs" id="summit-title" style="left:{{ 110 if not V else 70 }}px;bottom:{{ 120 if not V else 300 }}px;color:var(--cream)">
    <div class="mask"><span class="w anton" style="font-size:{{ 170 if not V else 130 }}px" data-w="0">Imagine</span></div>
    <div class="mask"><span class="w anton" style="font-size:{{ 170 if not V else 130 }}px" data-w="1">it every</span></div><br>
    <div class="mask"><span class="w serif" style="font-size:{{ 170 if not V else 140 }}px;line-height:1.05;color:#9fcbea" data-w="2">morning.</span></div>
  </div>
  <div class="abs" id="wipe" style="left:0;right:0;bottom:0;height:100%;background:var(--cream);transform:translateY(100%)"></div>
</section>

<!-- 5 · Meet Khun Boon -->
<section class="scene" id="meet">
  <div class="abs" id="meet-boon" style="width:{{ 520 if not V else 560 }}px">{{ boon('welcome') }}</div>
  <div class="abs" id="meet-text">
    <p class="mono" style="font-size:18px;color:rgba(23,23,23,.6)" data-w="0">Your concierge</p>
    <div class="mask" style="margin-top:20px"><span class="w anton" style="font-size:{{ 150 if not V else 120 }}px" data-w="1">Meet</span></div><br>
    <div class="mask"><span class="w anton" style="font-size:{{ 150 if not V else 120 }}px" data-w="2">Khun Boon.</span></div>
  </div>
</section>

<!-- 6 · One desk, your whole move -->
<section class="scene" id="system">
  <svg class="abs" id="links" width="{{ W }}" height="{{ H }}" style="inset:0"></svg>
  <div class="abs" id="sys-boon" style="width:{{ 300 if not V else 330 }}px">{{ boon('notes') }}</div>
  {% for key, label, icon in nodes %}<div class="node" data-node="{{ loop.index0 }}">{{ icon|safe }}<span class="mono">{{ label }}</span></div>{% endfor %}
  <div class="abs center" id="sys-title" style="top:{{ 70 if not V else 150 }}px">
    <div class="mask"><span class="w anton" style="font-size:{{ 96 if not V else 104 }}px" data-w="0">One desk.</span></div>{% if V %}<br>{% endif %}
    <div class="mask"><span class="w serif" style="font-size:{{ 92 if not V else 96 }}px;line-height:1.05" data-w="1">Your whole move.</span></div>
  </div>
</section>

<!-- 7 · Find the route that fits -->
<section class="scene" id="routes">
  <div class="abs center" id="routes-title" style="top:{{ 80 if not V else 150 }}px;color:var(--cream)">
    <div class="mask"><span class="w anton" style="font-size:{{ 96 if not V else 104 }}px" data-w="0">Find the route</span></div>{% if V %}<br>{% endif %}
    <div class="mask"><span class="w serif" style="font-size:{{ 92 if not V else 96 }}px;line-height:1.05;color:#9fcbea" data-w="1">that fits you.</span></div>
  </div>
  {% for num, unit, name, note in routes %}<div class="tile" data-tile="{{ loop.index0 }}"><div class="num" data-count="{{ num }}">0<small>{{ unit }}</small></div><div><h3>{{ name }}</h3><p>{{ note }}</p></div></div>{% endfor %}
</section>

<!-- 8 · Homes -->
<section class="scene" id="homes">
  <div class="browser" id="browser"><div class="browser-bar"><i></i><i></i><i></i><span class="mono" style="font-size:15px">secondhomethailand.com/properties</span></div><img id="site-shot" src="img/properties.png" style="display:block;width:100%"></div>
  <div class="abs" id="homes-text">
    <div class="mask"><span class="w anton" id="homes-count" style="font-size:{{ 200 if not V else 180 }}px;color:var(--blue)" data-w="0">0</span></div><br>
    <div class="mask"><span class="w anton" style="font-size:{{ 110 if not V else 100 }}px" data-w="1">Homes.</span></div><br>
    <div class="mask"><span class="w serif" style="font-size:{{ 64 if not V else 60 }}px;line-height:1.15" data-w="2">Ownership questions</span></div><br>
    <div class="mask"><span class="w serif" style="font-size:{{ 64 if not V else 60 }}px;line-height:1.15" data-w="3">answered first.</span></div>
  </div>
  <div class="abs" id="homes-boon" style="width:{{ 230 if not V else 250 }}px">{{ boon('calendar') }}</div>
</section>

<!-- 9 · In writing -->
<section class="scene" id="writing">
  <div class="abs" id="writing-title">
    <div class="mask"><span class="w anton" style="font-size:{{ 150 if not V else 130 }}px" data-w="0">No</span></div><br>
    <div class="mask"><span class="w anton" style="font-size:{{ 150 if not V else 130 }}px" data-w="1">surprises.</span></div>
  </div>
  <div class="doc" id="doc">
    <p class="mono" style="color:rgba(23,23,23,.6);margin-bottom:12px">Your engagement</p>
    {% for row in ['The scope', 'The fee', 'What is not included'] %}<div class="doc-row" data-row="{{ loop.index0 }}"><svg viewBox="0 0 40 40"><path d="M7 21l9 9L33 11" fill="none" stroke="#4a90c2" stroke-width="5" pathLength="1" stroke-dasharray="1" stroke-dashoffset="1"/></svg>{{ row }}</div>{% endfor %}
  </div>
  <div class="stamp" id="stamp">Agreed<br>in writing</div>
  <div class="abs" id="writing-boon" style="width:{{ 260 if not V else 280 }}px">{{ boon('success') }}</div>
</section>

<!-- 10 · Montage through the door -->
<section class="scene" id="montage">
  <svg class="abs" width="{{ W }}" height="{{ H }}" viewBox="0 0 {{ W }} {{ H }}" style="inset:0">
    <defs><clipPath id="mont-clip"><path id="mont-clip-path" d="{{ door_fill }}"/></clipPath></defs>
    <g id="mont-g">
      <g clip-path="url(#mont-clip)">{% for img in montage %}<image class="mont-img" href="img/{{ img }}.jpg" x="404" y="410" width="1240" height="1240" preserveAspectRatio="xMidYMid slice"/>{% endfor %}</g>
      <g fill="none" stroke-width="56" stroke-miterlimit="3"><path stroke="#e7e2d8" d="{{ door_path }}"/><path stroke="#4a90c2" d="M461 1539H654M754 1539H1294M1394 1539H1587"/></g>
    </g>
  </svg>
  <div class="abs center" id="mont-text" style="color:var(--cream)">
    <div class="mask"><span class="w anton" style="font-size:{{ 92 if not V else 84 }}px" data-w="0">Stay as long as</span></div><br>
    <div class="mask"><span class="w serif" style="font-size:{{ 92 if not V else 84 }}px;line-height:1.05" data-w="1">it feels like <span style="color:#9fcbea">home.</span></span></div>
  </div>
</section>

<!-- 11 · The Threshold, drawn -->
<section class="scene" id="logo-scene">
  <div class="abs" id="logo-wrap" style="color:var(--ink)">{{ logo('film-logo') }}</div>
  <div class="abs center" id="wordmark">
    <div class="anton" style="font-size:{{ 112 if not V else 96 }}px" data-w="0">Second Home Thailand</div>
    <p class="mono" style="font-size:20px;margin-top:22px;color:rgba(23,23,23,.6)" data-w="1">Residency concierge</p>
  </div>
  <div class="abs center" id="cta" style="opacity:0">
    <p class="anton" style="font-size:{{ 96 if not V else 74 }}px;letter-spacing:.01em">secondhomethailand.com</p>
    <div class="btn" style="margin-top:34px">Schedule a consultation <svg width="26" height="26" viewBox="0 0 24 24"><path d="M4 12h15m-6-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2"/></svg></div>
  </div>
  <div class="abs" id="cta-boon" style="width:{{ 260 if not V else 260 }}px;opacity:0">{{ boon('goodbye') }}</div>
</section>

</div>
<script>
const W = {{ W }}, H = {{ H }}, V = {{ 'true' if V else 'false' }};
const SCENES = {{ scenes|tojson }};
// ---- easing and helpers
const clamp = v => Math.min(1, Math.max(0, v));
const seg = (t, a, b) => clamp((t - a) / (b - a));
const lerp = (a, b, p) => a + (b - a) * p;
const outCubic = p => 1 - Math.pow(1 - p, 3);
const outExpo = p => p >= 1 ? 1 : 1 - Math.pow(2, -10 * p);
const inOut = p => p < .5 ? 4 * p * p * p : 1 - Math.pow(-2 * p + 2, 3) / 2;
const inCubic = p => p * p * p;
const outBack = p => { const c1 = 1.55, c3 = c1 + 1; return 1 + c3 * Math.pow(p - 1, 3) + c1 * Math.pow(p - 1, 2); };
const $ = s => document.querySelector(s);
const $$ = s => [...document.querySelectorAll(s)];
function put(el, o) {
  const s = el.style;
  if ('o' in o) s.opacity = o.o;
  const tr = [];
  if (o.x !== undefined || o.y !== undefined) tr.push(`translate(${(o.x || 0).toFixed(2)}px,${(o.y || 0).toFixed(2)}px)`);
  if (o.r !== undefined) tr.push(`rotate(${o.r.toFixed(3)}deg)`);
  if (o.s !== undefined) tr.push(`scale(${o.s.toFixed(4)})`);
  if (o.sx !== undefined) tr.push(`scale(${o.sx.toFixed(4)},${(o.sy ?? 1).toFixed(4)})`);
  if (tr.length) s.transform = tr.join(' ');
}
// words rise out of their masks, one after another
function words(root, t, start, gap, dur = .75) {
  root.querySelectorAll('[data-w]').forEach(el => {
    const i = +el.dataset.w, p = outCubic(seg(t, start + i * gap, start + i * gap + dur));
    const masked = !!el.closest('.mask');
    put(el, {y: (1 - p) * (masked ? el.offsetHeight * 1.08 : 30), o: masked ? 1 : p});
  });
}
function wordsOut(root, t, start, dur = .45) {
  const p = inCubic(seg(t, start, start + dur));
  if (p > 0) root.style.opacity = 1 - p, root.style.transform = `translateY(${-30 * p}px)`;
  else root.style.opacity = 1, root.style.transform = '';
}
let seed = 7; const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;

// ---- one-time layout
const flight = {waves: [], low: [], high: []};
(function setup() {
  const waves = $('#waves');
  for (let i = 0; i < 70; i++) { const d = document.createElement('div'); d.className = 'wave'; waves.appendChild(d); flight.waves.push({el: d, x: rnd() * W, y: rnd() * H * 1.2, w: 30 + rnd() * 90, sp: .8 + rnd() * .5}); }
  const make = (host, list, n, big, op) => { for (let i = 0; i < n; i++) { const c = document.createElement('div'); c.className = 'cloud'; const w = big * (0.6 + rnd() * .8); c.style.width = w + 'px'; c.style.height = w * .5 + 'px'; c.style.opacity = op; $(host).appendChild(c); list.push({el: c, x: rnd() * W - w / 2, y: rnd() * H * 1.6 - H * .3, w, sp: .7 + rnd() * .6}); } };
  make('#clouds-low', flight.low, 9, V ? 420 : 520, .5);
  make('#clouds-high', flight.high, 5, V ? 600 : 760, .85);
  // embers
  flight.embers = Array.from({length: 70}, () => ({x: rnd() * W, y: rnd() * H, r: .8 + rnd() * 2.4, sp: 18 + rnd() * 40, ph: rnd() * 6.28, life: 2 + rnd() * 4}));
})();
const door = {cx: 1024, cy: 1011};
function doorTransform(scale, cx = W / 2, cy = H / 2) { return `translate(${cx} ${cy}) scale(${scale}) translate(${-door.cx} ${-door.cy})`; }

// ---- scenes
const draw = {
  line(t) {
    const band = inOut(seg(t, 2.25, 3.05));
    const bar = $('#line-bar'), grow = outExpo(seg(t, .25, 1.45)), w = lerp((V ? .8 : .62) * W * grow, Math.max(W, H) * 1.6, band);
    bar.style.width = w + 'px'; bar.style.height = lerp(8, H * 1.2, band) + 'px';
    bar.style.marginLeft = -w / 2 + 'px'; bar.style.marginTop = -lerp(8, H * 1.2, band) / 2 + 'px';
    bar.style.background = band > 0 ? `color-mix(in srgb, #4a90c2 ${100 - band * 100}%, #14202d)` : '#4a90c2';
    bar.style.transform = `rotate(${lerp(0, -4, outCubic(seg(t, 1.45, 2.4))) * (1 - band)}deg)`;
  },
  flight(t) {
    const push = inCubic(seg(t, 6.3, 7.2));
    // sea and clouds slide down: we fly forward
    flight.waves.forEach(w => { const y = (w.y + t * 260 * w.sp) % (H * 1.2) - H * .1; put(w.el, {x: w.x, y}); w.el.style.width = w.w + 'px'; });
    const cloud = (c, mult) => { const y = (c.y + t * 420 * c.sp * mult) % (H * 1.9) - H * .55; put(c.el, {x: c.x, y}); };
    flight.low.forEach(c => cloud(c, 1)); flight.high.forEach(c => cloud(c, 1.9));
    const sun = $('#sun'); put(sun, {x: W * (V ? .2 : .55), y: -700 + t * 12});
    const bank = Math.sin(t * .9) * 4, bob = Math.sin(t * 1.4) * 8;
    const ps = (V ? .95 : .82) * lerp(1, 2.6, push), py = lerp(V ? H * .66 : H * .74, -H * .25, push);
    put($('#plane'), {x: W / 2 - 260, y: py - 260 + bob, r: bank, s: ps * outCubic(seg(t, 0, .9))});
    put($('#plane-shadow'), {x: W / 2 - 260 + 60, y: py - 260 + 80 + bob, r: bank, s: ps * .9 * outCubic(seg(t, 0, .9))});
    const title = $('#flight-title'); title.style.top = (V ? H * .1 : H * .06) + 'px';
    words(title, t, 1.2, .65); wordsOut(title, t, 6.0, .5);
    $('#flight').style.filter = push > 0 ? `brightness(${1 + push * 1.4})` : '';
  },
  door(t) {
    const k = (V ? .86 : .74);
    const zoom = inCubic(seg(t, 2.7, 3.8));
    const s = k * Math.pow(9, zoom);
    $('#door-g').setAttribute('transform', doorTransform(s, W / 2, H / 2 - (V ? 40 : 20) + zoom * 60));
    const open = inOut(seg(t, .55, 1.8));
    $('#leaf-l').setAttribute('transform', `translate(704 0) scale(${lerp(1, .04, open)} 1) translate(-704 0)`);
    $('#leaf-r').setAttribute('transform', `translate(1344 0) scale(${lerp(1, .04, open)} 1) translate(-1344 0)`);
    $('#leaf-seam').style.opacity = 1 - seg(t, .55, .8);
    $('#door-warm').style.opacity = lerp(0, 1, outCubic(seg(t, .8, 2))) * (1 - seg(t, 3.0, 3.8));
    put($('#door-photo'), {s: lerp(1.12, 1.0, outCubic(seg(t, .6, 3.8)))});
    const txt = $('#door-text'); const p = outCubic(seg(t, 1.0, 1.8));
    put(txt, {o: p * (1 - seg(t, 2.6, 3.0)), y: (1 - p) * 26});
  },
  summit(t) {
    put($('#summit-photo'), {s: lerp(1.0, 1.08, t / 5)});
    const ctx = $('#embers').getContext('2d'); ctx.clearRect(0, 0, W, H);
    flight.embers.forEach(e => {
      const age = (t + e.ph) % e.life, y = e.y - age * e.sp, x = e.x + Math.sin(age * 1.6 + e.ph) * 10;
      const a = Math.min(1, age / .6, (e.life - age) / .8) * .9;
      const g = ctx.createRadialGradient(x, y, 0, x, y, e.r * 4); g.addColorStop(0, `rgba(255,214,160,${a})`); g.addColorStop(1, 'rgba(255,170,90,0)');
      ctx.fillStyle = g; ctx.beginPath(); ctx.arc(x, y, e.r * 4, 0, 6.3); ctx.fill();
    });
    words($('#summit-title'), t, .55, .38, .8);
    put($('#wipe'), {y: lerp(H, 0, inOut(seg(t, 4.35, 4.8)))});
  },
  meet(t) {
    const b = $('#meet-boon'); const p = outBack(seg(t, .05, .7));
    const bw = V ? 560 : 520;
    put(b, {x: V ? (W - bw) / 2 : 230, y: (V ? 760 : 170) + Math.sin(t * 2.2) * 6 + (1 - p) * 120, s: Math.max(.001, p), o: seg(t, 0, .15)});
    const eyes = b.querySelector('.b-eyes'); if (eyes) eyes.style.transform = ''; // welcome pose has happy eyes
    const tx = $('#meet-text'); tx.style.left = (V ? 90 : 860) + 'px'; tx.style.top = (V ? 260 : 330) + 'px';
    words(tx, t, .45, .3, .7);
  },
  system(t) {
    const cx = W / 2, cy = V ? H * .56 : H * .6, R = V ? 380 : 330, bw = V ? 330 : 300;
    const b = $('#sys-boon'); const p = outBack(seg(t, 0, .6));
    put(b, {x: cx - bw / 2, y: cy - bw * .62 + Math.sin(t * 2) * 5, s: p});
    words($('#sys-title'), t, .25, .45, .7);
    const nodes = $$('[data-node]'), n = nodes.length;
    const svg = $('#links'); if (!svg.childElementCount) nodes.forEach(() => { const l = document.createElementNS('http://www.w3.org/2000/svg', 'line'); l.setAttribute('stroke', '#171717'); l.setAttribute('stroke-width', '2.5'); l.setAttribute('stroke-dasharray', '8 10'); svg.appendChild(l); const d = document.createElementNS('http://www.w3.org/2000/svg', 'circle'); d.setAttribute('r', '9'); d.setAttribute('fill', '#4a90c2'); svg.appendChild(d); });
    const lines = $$('#links line'), dots = $$('#links circle');
    nodes.forEach((node, i) => {
      const ang = V ? (-90 + (i - (n - 1) / 2) * 0 + [-150, -30, 200, 90, -20][i] ) : 180 + (i * 180 / (n - 1));
      const a = (V ? [200, 340, 150, 30, 270][i] : [205, 245, 270, 295, 335][i]) * Math.PI / 180;
      const rx = V ? 380 : 640, ry = V ? 560 : 330;
      const x = cx + Math.cos(a) * rx, y = cy + Math.sin(a) * ry;
      const s0 = 1.0 + i * .55, pl = outCubic(seg(t, s0, s0 + .55)), pn = outBack(seg(t, s0 + .35, s0 + .9));
      put(node, {x, y, s: Math.max(.001, pn), o: seg(t, s0 + .35, s0 + .5)});
      const L = lines[i]; L.setAttribute('x1', cx); L.setAttribute('y1', cy); L.setAttribute('x2', lerp(cx, x, pl)); L.setAttribute('y2', lerp(cy, y, pl));
      const pulse = ((t - 4.4 - i * .18) % 1.4 + 1.4) % 1.4 / 1.4, live = t > 4.4;
      const d = dots[i]; d.setAttribute('cx', lerp(x, cx, pulse)); d.setAttribute('cy', lerp(y, cy, pulse)); d.style.opacity = live ? Math.sin(pulse * Math.PI) : 0;
    });
  },
  routes(t) {
    words($('#routes-title'), t, .1, .4, .7);
    const tiles = $$('[data-tile]'), tw = 360, gap = 36;
    tiles.forEach((tile, i) => {
      let x, y;
      if (V) { x = W / 2 - tw - gap / 2 + (i % 2) * (tw + gap); y = 520 + Math.floor(i / 2) * 470; }
      else { x = (W - (4 * tw + 3 * gap)) / 2 + i * (tw + gap); y = 380; }
      const p = outCubic(seg(t, .7 + i * .22, 1.5 + i * .22));
      tile.style.left = x + 'px'; tile.style.top = y + 'px';
      tile.style.transform = `perspective(1400px) rotateX(${(1 - p) * -95}deg)`; tile.style.opacity = seg(t, .7 + i * .22, .9 + i * .22);
      const num = tile.querySelector('[data-count]'), target = +num.dataset.count;
      num.firstChild.nodeValue = String(Math.round(target * outCubic(seg(t, 1.0 + i * .22, 2.4 + i * .22))));
    });
  },
  homes(t) {
    const br = $('#browser');
    const bw = V ? 920 : 1000, bh = V ? 900 : 860;
    br.style.width = bw + 'px'; br.style.height = bh + 'px';
    const p = outCubic(seg(t, 0, .8));
    put(br, {x: V ? (W - bw) / 2 : 820, y: (V ? 860 : 110) + (1 - p) * 80, o: p});
    const shot = $('#site-shot'); const scroll = inOut(seg(t, 1.2, 5.6));
    shot.style.transform = `translateY(${-scroll * Math.max(0, shot.offsetHeight - bh + 52)}px)`;
    const tx = $('#homes-text'); tx.style.left = (V ? 90 : 120) + 'px'; tx.style.top = (V ? 170 : 210) + 'px';
    words(tx, t, .3, .3, .7);
    $('#homes-count').firstChild.nodeValue = String(Math.round(386 * outCubic(seg(t, .4, 2.0))));
    const hb = $('#homes-boon'); const pb = outBack(seg(t, 1.4, 2.0));
    put(hb, {x: V ? W - 300 : 610, y: (V ? 610 : 700) + Math.sin(t * 2) * 5, s: Math.max(.001, pb)});
  },
  writing(t) {
    const tt = $('#writing-title'); tt.style.left = (V ? 90 : 130) + 'px'; tt.style.top = (V ? 170 : 300) + 'px';
    words(tt, t, .1, .25, .7);
    const doc = $('#doc'); const p = outCubic(seg(t, .3, 1.1));
    put(doc, {x: V ? (W - 560) / 2 : 860, y: (V ? 640 : 200) + (1 - p) * 100, r: lerp(6, -2, p), o: p});
    $$('[data-row]').forEach((row, i) => { const c = row.querySelector('path'); c.style.strokeDashoffset = 1 - outCubic(seg(t, 1.0 + i * .45, 1.4 + i * .45)); row.style.opacity = .35 + .65 * seg(t, .9 + i * .45, 1.1 + i * .45); });
    const st = $('#stamp'); const ps = seg(t, 2.75, 3.05), hit = ps >= 1;
    const shake = hit ? Math.sin((t - 3.05) * 60) * Math.max(0, 1 - (t - 3.05) * 4) * 6 : 0;
    put(st, {x: (V ? W / 2 - 60 : 1250) + shake, y: V ? 1260 : 700, r: -9, s: lerp(2.4, 1, inCubic(ps)), o: ps > 0 ? 1 : 0});
    put(doc, {x: (V ? (W - 560) / 2 : 860) + shake * .4, y: (V ? 640 : 200) + (1 - p) * 100, r: lerp(6, -2, p), o: p});
    const wb = $('#writing-boon'); const pb = outBack(seg(t, 1.6, 2.2));
    put(wb, {x: V ? 120 : 330, y: (V ? 1440 : 620) + Math.sin(t * 2.4) * 5, s: Math.max(.001, pb)});
  },
  montage(t) {
    const k = V ? .82 : .7;
    $('#mont-g').setAttribute('transform', doorTransform(k * lerp(.92, 1, outCubic(seg(t, 0, 1))), W / 2, V ? H * .42 : H * .43));
    const imgs = $$('.mont-img'), each = 1.25;
    imgs.forEach((im, i) => {
      const a = i * each, local = t - a;
      const vis = i === imgs.length - 1 ? local >= 0 : local >= 0 && local < each + .25;
      im.style.opacity = vis ? Math.min(1, local / .25) : 0;
      const s = 1.12 - .1 * clamp(local / (each + .25));
      im.setAttribute('transform', `translate(1024 1030) scale(${s}) translate(-1024 -1030)`);
    });
    const tx = $('#mont-text'); tx.style.top = (V ? H * .76 : H * .8) + 'px';
    words(tx, t, 1.0, .5, .8);
  },
  'logo-scene'(t) {
    const lw = V ? 420 : 380;
    const wrap = $('#logo-wrap'); wrap.style.width = lw + 'px';
    const settle = inOut(seg(t, 4.6, 5.3));
    put(wrap, {x: W / 2 - lw / 2, y: lerp(V ? H * .24 : H * .1, V ? H * .12 : H * .02, settle), s: lerp(1, .58, settle)});
    const c = $('.film-logo .lg-line-c'), l = $('.film-logo .lg-line-l'), r = $('.film-logo .lg-line-r'), d = $('.film-logo .lg-door');
    [c, l, r].forEach(el => el.style.transformBox = 'fill-box');
    c.style.transformOrigin = '50% 50%'; l.style.transformOrigin = '100% 50%'; r.style.transformOrigin = '0 50%';
    c.style.transform = `scaleX(${outExpo(seg(t, .15, .8))})`;
    l.style.transform = r.style.transform = `scaleX(${outCubic(seg(t, .55, 1.0))})`;
    d.style.strokeDasharray = 1; d.style.strokeDashoffset = 1 - inOut(seg(t, .55, 1.75));
    const wm = $('#wordmark'); wm.style.top = (V ? H * .52 : H * .66) + 'px';
    wm.querySelectorAll('[data-w]').forEach(el => { const i = +el.dataset.w, p = outCubic(seg(t, 1.6 + i * .35, 2.3 + i * .35)); put(el, {o: p, y: (1 - p) * 24}); });
    put(wm, {o: 1 - seg(t, 4.5, 4.9)});
    const cta = $('#cta'); cta.style.top = (V ? H * .38 : H * .42) + 'px'; const pc = outCubic(seg(t, 5.0, 5.7)); put(cta, {o: pc, y: (1 - pc) * 30});
    const cb = $('#cta-boon'); const pb = outBack(seg(t, 5.4, 6.0));
    put(cb, {x: V ? W / 2 - 120 : W - 360, y: V ? H * .66 : H - 400, s: Math.max(.001, pb), o: seg(t, 5.4, 5.5)});
    const wave = cb.querySelector('.b-wave'); if (wave) { wave.style.transformBox = 'fill-box'; wave.style.transformOrigin = '0 100%'; const wv = seg(t, 6.0, 8.0); wave.style.transform = `rotate(${Math.sin(wv * Math.PI * 4) * 14 * (1 - wv)}deg)`; }
  },
};
// The cut list lives in SCENES: [id, start, end, offset]. offset lets a cutdown begin a scene part-way.
window.render = function (time) {
  SCENES.forEach(([id, start, end, offset]) => {
    const el = document.getElementById(id), on = time >= start && time < end;
    el.style.visibility = on ? 'visible' : 'hidden';
    if (on) draw[id](time - start + (offset || 0));
  });
};
window.ready = async function () {
  await document.fonts.ready;
  await Promise.all([...document.images].map(i => i.decode().catch(() => {})));
  render(0);
  return true;
};
</script>
</body>
