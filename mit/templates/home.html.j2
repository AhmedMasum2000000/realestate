{% extends 'base.html.j2' %}
{% from 'components.html.j2' import eyebrow, faq, cta with context %}
{% block content %}
<section class="story-hero" data-story-hero data-frames="{{ asset('frames/') }}" data-count-desktop="{{ frames.desktop.count if frames.desktop is defined else 0 }}" data-count-mobile="{{ frames.mobile.count if frames.mobile is defined else 0 }}" aria-labelledby="story-title">
  <div class="story-stage">
    <picture class="story-poster"><source media="(max-width: 700px)" srcset="{{ asset('frames/mobile/001.webp') }}" width="540" height="960"><img src="{{ asset('frames/desktop/001.webp') }}" alt="A quiet Thai beach with clear water and a longtail boat" width="1280" height="720" fetchpriority="high"></picture>
    <canvas class="story-canvas" aria-hidden="true"></canvas>
    <div class="story-shade" aria-hidden="true"></div>
    <div class="story-dim" aria-hidden="true"></div>
    <div class="story-labels" aria-hidden="true">
      <span class="story-label story-label-tl">12°55′N · 100°52′E<br>Pattaya, Thailand</span>
      <span class="story-label story-label-tr"><b data-local-time>GMT+7</b><br>Local time, Pattaya</span>
      <span class="story-label story-label-bl"><b data-scene-number>01</b> / 04 · <span data-scene-name>The coast</span></span>
      <span class="story-label story-label-br">Scroll the story<i class="story-meter"><i data-story-meter></i></i></span>
    </div>
    <div class="story-intro wrap">
      <p class="story-brand"><span>Move In Thailand</span></p>
      <h1 id="story-title"><span class="story-line" data-exit="left"><span>Your next chapter.</span></span> <span class="story-line" data-exit="scale"><span>Starts in</span></span> <span class="story-line" data-exit="right"><span><em>Thailand.</em></span></span></h1>
      <div class="story-intro-meta"><div class="story-intro-in">
        <p class="story-sub">From your first visa question to a place that feels like home. One local desk to help turn “what if” into a move you understand.</p>
        <div class="button-row"><a class="button" href="{{ url('tools/visa-finder/') }}">Find my visa options {{ icon('arrow') }}</a><a class="text-link story-link" href="{{ url('contact/') }}">Talk through my move {{ icon('arrow') }}</a></div>
        <p class="story-reassure">{{ icon('check') }} Four questions. A starting shortlist. No contact details needed.</p>
      </div></div>
    </div>
    <p class="story-tagline" data-tagline aria-hidden="true">The visa. The home. The business.<br><em>One clear plan.</em></p>
    <p class="story-tagline" data-tagline aria-hidden="true">Know the rules. Know the costs.<br><em>Then make the move.</em></p>
  </div>
  <div class="story-end">
    <div class="wrap story-end-inner">
      <div class="story-end-left">
        {{ eyebrow('YOUR MOVE, CONNECTED') }}
        <h2>Visa → Home →<br><em>A life here.</em></h2>
        <ul class="check-list">
          <li>{{ icon('check') }}<span>A visa route matched to why you are coming</span></li>
          <li>{{ icon('check') }}<span>Homes to rent or buy through our Pattaya property partner</span></li>
          <li>{{ icon('check') }}<span>A written scope and fee breakdown before any paid work</span></li>
          <li>{{ icon('check') }}<span>Help with 90-day reports and renewals after you arrive</span></li>
        </ul>
      </div>
      <div class="story-end-right">
        {{ eyebrow('START WITH ONE QUESTION') }}
        <h3>Which visa could fit you?</h3>
        <p>Answer four questions. See a shortlist of routes and the official sources to check. No email wall.</p>
        <a class="button" href="{{ url('tools/visa-finder/') }}">Start the Visa Finder {{ icon('arrow') }}</a>
        <a class="text-link" href="{{ url('contact/') }}">Or talk to our desk {{ icon('arrow') }}</a>
      </div>
    </div>
  </div>
</section>
<section class="promise-strip"><div class="wrap"><p>{{ icon('compass') }}<span>One desk for<br><strong>your whole move</strong></span></p><p>{{ icon('receipt') }}<span>Clear scope.<br><strong>Written fee breakdown.</strong></span></p><p>{{ icon('shield') }}<span>Appropriate checks.<br><strong>Before commitments.</strong></span></p><p>{{ icon('pin') }}<span>A Pattaya base.<br><strong>Support beyond arrival.</strong></span></p></div></section>
<section class="section routes-section"><div class="wrap">
  <div class="section-heading"><div>{{ eyebrow('START WITH YOU') }}<h2>What brings you<br>to Thailand?</h2></div><p>Different lives need different plans.<br>Choose the story that feels closest to yours.</p></div>
  <div class="intent-grid">
    {% for title,sub,icon_name,path in [('A new pace of life','Retirement & long stays','sun','visas/retirement/'),('Work from somewhere new','Remote work & DTV','laptop','visas/dtv/'),('A life together','Families & partners','heart','visas/marriage/'),('Your next opportunity','Business & investment','briefcase','business/')] %}
    <a class="intent-card" href="{{ url(path) }}"><span class="intent-icon">{{ icon(icon_name) }}</span><span><strong>{{ title }}</strong><small>{{ sub }}</small></span>{{ icon('arrow') }}</a>
    {% endfor %}
  </div>
  <p class="section-footnote">Not sure where you fit? <a href="{{ url('tools/visa-finder/') }}">Find a starting shortlist in a few questions {{ icon('arrow') }}</a></p>
</div></section>
<section class="section routes-compare"><div class="wrap">
  <div class="section-heading"><div>{{ eyebrow('THE LONG-STAY ROUTES, SIDE BY SIDE') }}<h2>Four ways to stay.<br><em>Compare before you commit.</em></h2></div><p>How long each approval lasts, what you need to show and whether you can work.<br>Then open the guide for the details.</p></div>
  <div class="route-specs">{% for route in route_specs %}
    <article class="route-spec glow-card">
      <span class="eyebrow">{{ route.short }}</span>
      <h3>{{ route.name }}</h3>
      <div class="spec-meter"><div class="spec-meter-top"><span>Permission per approval</span><b>{{ route.length }}</b></div><div class="spec-bar" role="img" aria-label="{{ route.years }} of 20 years"><i style="--fill:{{ '%.3f'|format(route.years / 20) }}"></i></div></div>
      <dl>
        <div><dt>Suits</dt><dd>{{ route.suits }}</dd></div>
        <div><dt>Money to show</dt><dd>{{ route.money }}</dd></div>
        <div><dt>Work</dt><dd>{{ route.work }}</dd></div>
      </dl>
      <a class="text-link" href="{{ url('visas/' ~ route.slug ~ '/') }}">Explore the {{ route.short }} {{ icon('arrow') }}</a>
    </article>{% endfor %}
  </div>
  <p class="section-footnote">The authorities decide eligibility, and rules change. Every guide links the official source. <a href="{{ url('visas/') }}">Compare all visa routes {{ icon('arrow') }}</a></p>
</div></section>
<section class="statement-section"><div class="wrap">
  <p class="statement" data-scramble><span class="statement-a">Big life decisions.</span> <em class="statement-b">Made one clear step at a time.</em></p>
  <ul class="stats-strip">{% for value, label in stats %}<li class="stat"><b data-count="{{ value }}">{{ value }}</b><span>{{ label }}</span></li>{% endfor %}</ul>
</div></section>
<section class="section story-section"><div class="wrap story-grid">
  <div class="story-image"><img src="{{ asset('home.webp') }}" alt="A pool villa from our Pattaya property partner’s library" width="800" height="600" loading="lazy"><div class="story-caption"><span>YOUR HOME. YOUR ROUTINE. YOUR NEXT CHAPTER.</span><p>Life here starts feeling real<br>one everyday moment at a time.</p></div></div>
  <div class="story-copy">{{ eyebrow('MORE THAN A VISA') }}<h2>You’re not moving<br>paperwork.<br><em>You’re moving a life.</em></h2><p>There’s the visa. Then there’s the home, the first week, the questions nobody puts on a checklist.</p><p>We bring those conversations together. So the choices support each other, the costs are easier to understand, and you know what comes next.</p><a class="text-link" href="{{ url('services/') }}">See how we connect your move {{ icon('arrow') }}</a><div class="handwritten">A little clarity changes everything.</div></div>
</div></section>
<section class="section services-section"><div class="wrap"><div class="section-heading"><div>{{ eyebrow('ONE DESK. THE WHOLE PICTURE.') }}<h2>From the first question<br>to feeling at home.</h2></div><a class="text-link" href="{{ url('fees/') }}">Understand the costs {{ icon('arrow') }}</a></div>
  <div class="services-grid">{% for service in services %}<article class="service-card"><span class="service-label">{{ service.label }}</span><div class="service-icon">{{ icon(service.icon) }}</div><h3>{{ service.title }}</h3><p>{{ service.text }}</p><a class="text-link" href="{{ url(service.href) }}">{{ service.link }} {{ icon('arrow') }}</a></article>{% endfor %}</div>
</div></section>
<section class="section finder-feature"><div class="wrap finder-feature-grid"><div>{{ eyebrow('YOUR FIRST USEFUL ANSWER') }}<h2>“Which visa<br>could fit <em>me?</em>”</h2><p>Start with your purpose, your work and your plans. The Visa Finder gives you routes to explore and the questions to check next.</p><ul class="check-list"><li>{{ icon('check') }} A shortlist around your circumstances</li><li>{{ icon('check') }} Official sources to check for yourself</li><li>{{ icon('check') }} No email wall to see your results</li></ul><a class="button" href="{{ url('tools/visa-finder/') }}">Find my starting point {{ icon('arrow') }}</a></div><div class="finder-preview"><div class="preview-top"><span>{{ icon('compass') }} VISA FINDER</span><span>01 / 04</span></div><div class="mini-progress"><span></span></div><h3>What would you like<br>to do in Thailand?</h3><a href="{{ url('tools/visa-finder/?purpose=remote') }}">{{ icon('laptop') }} Work remotely <span>↗</span></a><a href="{{ url('tools/visa-finder/?purpose=retire') }}">{{ icon('sun') }} Enjoy retirement <span>↗</span></a><a href="{{ url('tools/visa-finder/?purpose=business') }}">{{ icon('briefcase') }} Start a business <span>↗</span></a><p>A starting point for a conversation.<br>Authorities decide eligibility and approval.</p></div></div></section>
<section class="section process-section"><div class="wrap"><div class="section-heading"><div>{{ eyebrow('A MOVE WITH A LITTLE MORE ORDER') }}<h2>Four steps.<br>One less thing to worry about.</h2></div><p>You stay in control of the decision.<br>We help make the next step clearer.</p></div><ol class="process-grid">{% for title,text in [('Tell us your story','Your purpose, your timeline and what matters most. No need to have it all figured out.'),('Get a clear plan','Compare routes and priorities. Know what needs checking and who handles it.'),('Agree the details','A written scope, an itemised quote and the documents needed before paid work starts.'),('Move, then settle','Coordinate the arrival and the everyday steps. Plan the ongoing support you need.')] %}<li><span class="step-number">0{{ loop.index }}</span><h3>{{ title }}</h3><p>{{ text }}</p></li>{% endfor %}</ol><p class="section-footnote">Want the whole journey in order? <a href="{{ url('start-here/') }}">Read the five-step moving guide {{ icon('arrow') }}</a></p></div></section>
<section class="section tools-section"><div class="wrap"><div class="section-heading"><div>{{ eyebrow('LESS GUESSWORK. MORE CLARITY.') }}<h2>A few things to make<br>your next step easier.</h2></div><a class="text-link" href="{{ url('tools/') }}">Explore all tools {{ icon('arrow') }}</a></div><div class="tool-grid"><a class="tool-card" href="{{ url('tools/cost-calculator/') }}"><span class="tool-art budget-art">฿ <i>+ −</i></span><span class="eyebrow">BUILD YOUR BUDGET</span><h3>What could life here cost?</h3><p>Bring rent, everyday costs and the first-month setup onto one page.</p><span class="text-link">Try the cost calculator {{ icon('arrow') }}</span></a><a class="tool-card" href="{{ url('living/moving-checklist/') }}"><span class="tool-art checklist-art">{{ icon('check') }} <i>01<br>02<br>03</i></span><span class="eyebrow">PUT THE MOVE IN ORDER</span><h3>What do I do first?</h3><p>A practical checklist for before the flight, arrival and the first month.</p><span class="text-link">Get the moving checklist {{ icon('arrow') }}</span></a><a class="tool-card" href="{{ url('tools/ownership-checker/') }}"><span class="tool-art house-art">{{ icon('home') }}</span><span class="eyebrow">BEFORE YOU COMMIT</span><h3>What should I check?</h3><p>Start the right ownership questions before a property purchase.</p><span class="text-link">Explore the ownership checklist {{ icon('arrow') }}</span></a></div></div></section>
{{ faq(faqs) }}
{{ cta() }}
{% endblock %}

