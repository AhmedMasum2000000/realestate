{% extends 'base.html.j2' %}
{% from 'components.html.j2' import eyebrow, faq, cta with context %}
{% block content %}
<section class="story-hero" data-story-hero data-frames="{{ asset('frames/') }}" data-count-desktop="{{ frames.desktop.count if frames.desktop is defined else 0 }}" data-count-mobile="{{ frames.mobile.count if frames.mobile is defined else 0 }}" aria-labelledby="story-title">
  <div class="story-stage">
    <picture class="story-poster"><source media="(max-width: 700px)" srcset="{{ asset('frames/mobile/001.webp') }}" width="540" height="960"><img src="{{ asset('frames/desktop/001.webp') }}" alt="A quiet Thai beach with clear water and a longtail boat" width="1280" height="720" fetchpriority="high"></picture>
    <canvas class="story-canvas" aria-hidden="true"></canvas>
    <div class="story-shade" aria-hidden="true"></div>
    <div class="story-dim" aria-hidden="true"></div>
    <div class="story-labels" aria-hidden="true">
      <span class="story-label story-label-tl">12°55′N · 100°52′E<br>Pattaya, Thailand</span>
      <span class="story-label story-label-tr"><b data-local-time>GMT+7</b><br>Local time, Pattaya</span>
      <span class="story-label story-label-bl"><b data-scene-number>01</b> / 04 · <span data-scene-name>The coast</span></span>
      <span class="story-label story-label-br">Scroll the story<i class="story-meter"><i data-story-meter></i></i></span>
    </div>
    <div class="story-intro wrap">
      <p class="story-brand"><span>Move In Thailand</span></p>
      <h1 id="story-title"><span class="story-line" data-exit="left"><span>Your next chapter.</span></span> <span class="story-line" data-exit="scale"><span>Starts in</span></span> <span class="story-line" data-exit="right"><span><em>Thailand.</em></span></span></h1>
      <div class="story-intro-meta"><div class="story-intro-in">
        <p class="story-ask"><span class="visually-hidden">Want to retire, work remotely, live with your family, start a business or buy a home in Thailand?</span><span aria-hidden="true">Want to <span class="rotator" data-rotator><span>retire by the sea</span><span>work from anywhere</span><span>live with your family</span><span>start a business</span><span>buy a home</span></span>?</span></p>
        <p class="story-sub">One local desk in Pattaya plans your visa, your home and your business together. <mark class="hl hl-dark" data-hl-load>Less guesswork. Fewer surprises. One clear plan.</mark></p>
        <div class="button-row"><a class="button" href="{{ url('tools/visa-finder/') }}">Find my visa in 2 minutes {{ icon('arrow') }}</a><a class="text-link story-link" href="{{ url('contact/') }}">Talk to our Pattaya desk {{ icon('arrow') }}</a></div>
        <ul class="ease-chips" aria-label="Visa Finder: 4 questions, about 2 minutes, no sign-up"><li><b data-tick="4">4</b> questions</li><li><b data-tick="2">2</b> minutes</li><li><b data-tick="0" data-from="9">0</b> sign-ups</li></ul>
      </div></div>
    </div>
    <p class="story-tagline" data-tagline aria-hidden="true">The visa. The home. The business.<br><em><mark class="hl hl-dark">One desk. One clear plan.</mark></em></p>
    <p class="story-tagline" data-tagline aria-hidden="true">Know the rules. Know the costs.<br><em><mark class="hl hl-dark">Then move with confidence.</mark></em></p>
  </div>
  <div class="story-end">
    <div class="wrap story-end-inner">
      <div class="story-end-left">
        {{ eyebrow('YOUR MOVE, CONNECTED') }}
        <h2>Visa → Home →<br><em><mark class="hl hl-dark">A life here.</mark></em></h2>
        <ul class="check-list">
          <li>{{ icon('check') }}<span>The right visa for why you are coming</span></li>
          <li>{{ icon('check') }}<span>Homes to rent or buy, through our Pattaya property partner</span></li>
          <li>{{ icon('check') }}<span>Every fee in writing before any paid work</span></li>
          <li>{{ icon('check') }}<span>90-day reports and renewals tracked after you land</span></li>
        </ul>
      </div>
      <div class="story-end-right">
        {{ eyebrow('TAKES ABOUT 2 MINUTES') }}
        <h3>Which visa fits <em>you?</em></h3>
        <p>Four quick questions. A shortlist of routes, with the official sources to check. No email, no sign-up.</p>
        <a class="button" href="{{ url('tools/visa-finder/') }}">Show my visa options {{ icon('arrow') }}</a>
        <a class="text-link" href="{{ url('contact/') }}">Or talk to our desk {{ icon('arrow') }}</a>
      </div>
    </div>
  </div>
</section>
<section class="promise-strip"><div class="wrap"><p>{{ icon('compass') }}<span>One desk.<br><strong>Your whole move.</strong></span></p><p>{{ icon('receipt') }}<span>Fees in writing.<br><strong>Before you pay.</strong></span></p><p>{{ icon('shield') }}<span>Checks first.<br><strong>Commitments later.</strong></span></p><p>{{ icon('pin') }}<span>Based in Pattaya.<br><strong>Here after you land.</strong></span></p></div></section>
<section class="section routes-section"><div class="wrap">
  <div class="section-heading"><div>{{ eyebrow('START WITH YOU') }}<h2>What brings you<br>to <mark class="hl">Thailand?</mark></h2></div><p>Pick your reason. We will show you<br>the shortest sensible route from there.</p></div>
  <div class="intent-grid">
    {% for title,sub,icon_name,path in [('A new pace of life','Retirement & long stays','sun','visas/retirement/'),('Work from somewhere new','Remote work & DTV','laptop','visas/dtv/'),('A life together','Families & partners','heart','visas/marriage/'),('Your next opportunity','Business & investment','briefcase','business/')] %}
    <a class="intent-card" href="{{ url(path) }}"><span class="intent-icon">{{ icon(icon_name) }}</span><span><strong>{{ title }}</strong><small>{{ sub }}</small></span>{{ icon('arrow') }}</a>
    {% endfor %}
  </div>
  <p class="section-footnote">Not sure where you fit? <a href="{{ url('tools/visa-finder/') }}">Get your shortlist in 4 questions {{ icon('arrow') }}</a></p>
</div></section>
<section class="section routes-compare"><div class="wrap">
  <div class="section-heading"><div>{{ eyebrow('THE 4 LONG-STAY VISAS, SIDE BY SIDE') }}<h2>Four ways to stay.<br><em><mark class="hl">Compared in one minute.</mark></em></h2></div><p>How long you can stay, what you need to show and whether you can work.<br>One screen instead of hours of searching.</p></div>
  <div class="route-specs">{% for route in route_specs %}
    <article class="route-spec glow-card">
      <span class="eyebrow">{{ route.short }}</span>
      <h3>{{ route.name }}</h3>
      <div class="spec-meter"><div class="spec-meter-top"><span>Permission per approval</span><b>{{ route.length }}</b></div><div class="spec-bar" role="img" aria-label="{{ route.years }} of 20 years"><i style="--fill:{{ '%.3f'|format(route.years / 20) }}"></i></div></div>
      <dl>
        <div><dt>Suits</dt><dd>{{ route.suits }}</dd></div>
        <div><dt>Money to show</dt><dd>{{ route.money }}</dd></div>
        <div><dt>Work</dt><dd>{{ route.work }}</dd></div>
      </dl>
      <a class="text-link" href="{{ url('visas/' ~ route.slug ~ '/') }}">Explore the {{ route.short }} {{ icon('arrow') }}</a>
    </article>{% endfor %}
  </div>
  <p class="section-footnote">The authorities decide eligibility, and rules change. Every guide links the official source. <a href="{{ url('visas/') }}">Compare all visa routes {{ icon('arrow') }}</a></p>
</div></section>
<div class="marquee" data-marquee aria-hidden="true"><div class="marquee-track">{% for copy in range(2) %}<span class="marquee-group">{% for word in ['Retirement','Remote work','Family','Pool villas','Condos','Company setup','Investment','90-day reports','Pattaya'] %}<span>{{ word }}</span><i></i>{% endfor %}</span>{% endfor %}</div></div>
<section class="statement-section"><div class="wrap">
  <p class="statement" data-scramble><span class="statement-a">Big life decisions.</span> <em class="statement-b">Made one clear step at a time.</em></p>
  <ul class="stats-strip">{% for value, label in stats %}<li class="stat"><b data-count="{{ value }}">{{ value }}</b><span>{{ label }}</span></li>{% endfor %}</ul>
</div></section>
<section class="section story-section"><div class="wrap story-grid">
  <div class="story-image"><img src="{{ asset('home.webp') }}" alt="A pool villa from our Pattaya property partner’s library" width="800" height="600" loading="lazy"><ul class="trust-chips" aria-label="Why people trust the plan"><li>{{ icon('check') }} Official sources on every guide</li><li>{{ icon('check') }} Every fee in writing first</li><li>{{ icon('check') }} A local desk in Pattaya</li></ul><div class="story-caption"><span>YOUR HOME. YOUR ROUTINE. YOUR NEXT CHAPTER.</span><p>Life here starts feeling real<br>one everyday moment at a time.</p></div></div>
  <div class="story-copy">{{ eyebrow('MORE THAN A VISA') }}<h2>You’re not moving<br>paperwork.<br><em><mark class="hl">You’re moving a life.</mark></em></h2><p>The visa is only the start. Then come the lease, the bank account, the first week, and the questions nobody puts on a checklist.</p><p>We put those pieces into one plan, so each choice supports the next, <mark class="hl">the costs are clear up front</mark> and you always know what comes next.</p><a class="text-link" href="{{ url('services/') }}">See how we connect your move {{ icon('arrow') }}</a><div class="handwritten">A little clarity changes everything.</div></div>
</div></section>
<section class="section services-section"><div class="wrap"><div class="section-heading"><div>{{ eyebrow('ONE DESK. THE WHOLE PICTURE.') }}<h2>From the first question<br>to <mark class="hl">feeling at home.</mark></h2></div><a class="text-link" href="{{ url('fees/') }}">See what it costs {{ icon('arrow') }}</a></div>
  <div class="services-grid">{% for service in services %}<article class="service-card"><span class="service-label">{{ service.label }}</span><div class="service-icon">{{ icon(service.icon) }}</div><h3>{{ service.title }}</h3><p>{{ service.text }}</p><a class="text-link" href="{{ url(service.href) }}">{{ service.link }} {{ icon('arrow') }}</a></article>{% endfor %}</div>
</div></section>
<section class="section finder-feature"><div class="wrap finder-feature-grid"><div>{{ eyebrow('YOUR FIRST USEFUL ANSWER') }}<h2>“Which visa<br>could fit <em>me?</em>”</h2><p>Tell it your purpose, your money and your plans. Get routes to explore and the exact questions to check next, <mark class="hl">in about two minutes.</mark></p><ul class="check-list"><li>{{ icon('check') }} A shortlist built around you</li><li>{{ icon('check') }} Official sources to check for yourself</li><li>{{ icon('check') }} No email wall to see your results</li></ul><a class="button" href="{{ url('tools/visa-finder/') }}">Find my visa in 2 minutes {{ icon('arrow') }}</a></div><div class="finder-preview"><div class="preview-top"><span>{{ icon('compass') }} VISA FINDER</span><span>01 / 04</span></div><div class="mini-progress"><span></span></div><h3>What would you like<br>to do in Thailand?</h3><a href="{{ url('tools/visa-finder/?purpose=remote') }}">{{ icon('laptop') }} Work remotely <span>↗</span></a><a href="{{ url('tools/visa-finder/?purpose=retire') }}">{{ icon('sun') }} Enjoy retirement <span>↗</span></a><a href="{{ url('tools/visa-finder/?purpose=business') }}">{{ icon('briefcase') }} Start a business <span>↗</span></a><p>A starting point for a conversation.<br>Authorities decide eligibility and approval.</p></div></div></section>
<section class="section process-section"><div class="wrap"><div class="section-heading"><div>{{ eyebrow('A MOVE WITH A LITTLE MORE ORDER') }}<h2>Four steps.<br><mark class="hl">One less thing to worry about.</mark></h2></div><p>You stay in control of every decision.<br>We do the legwork of making the next step clear.</p></div><ol class="process-grid">{% for title,text in [('Tell us your story','Your purpose, your timeline and what matters most. You do not need it all figured out.'),('Get a clear plan','Routes compared, priorities set, and who handles what, in writing.'),('Agree the details','A written scope, an itemised quote and your document list before any paid work.'),('Move, then settle','Arrival, home and the everyday steps, then the renewals that keep you legal.')] %}<li><span class="step-number">0{{ loop.index }}</span><h3>{{ title }}</h3><p>{{ text }}</p></li>{% endfor %}</ol><p class="section-footnote">Want the whole journey in order? <a href="{{ url('start-here/') }}">Read the five-step moving guide {{ icon('arrow') }}</a></p></div></section>
<section class="section tools-section"><div class="wrap"><div class="section-heading"><div>{{ eyebrow('FREE TOOLS. NO SIGN-UP.') }}<h2>Get answers now,<br><mark class="hl">not after a week of emails.</mark></h2></div><a class="text-link" href="{{ url('tools/') }}">Explore all tools {{ icon('arrow') }}</a></div><div class="tool-grid"><a class="tool-card" href="{{ url('tools/cost-calculator/') }}"><span class="tool-art budget-art">฿ <i>+ −</i></span><span class="eyebrow">BUILD YOUR BUDGET</span><h3>What will life here cost you?</h3><p>Rent, food, transport and setup on one page. See your monthly number in seconds.</p><span class="text-link">Try the cost calculator {{ icon('arrow') }}</span></a><a class="tool-card" href="{{ url('living/moving-checklist/') }}"><span class="tool-art checklist-art">{{ icon('check') }} <i>01<br>02<br>03</i></span><span class="eyebrow">PUT THE MOVE IN ORDER</span><h3>What do I do first?</h3><p>Before the flight, arrival day and the first month, in order. A free PDF to keep.</p><span class="text-link">Get the moving checklist {{ icon('arrow') }}</span></a><a class="tool-card" href="{{ url('tools/ownership-checker/') }}"><span class="tool-art house-art">{{ icon('home') }}</span><span class="eyebrow">BEFORE YOU COMMIT</span><h3>Can you own it?</h3><p>Answer a few questions before you buy, and know what is possible first.</p><span class="text-link">Explore the ownership checklist {{ icon('arrow') }}</span></a></div></div></section>
{{ faq(faqs) }}
{{ cta() }}
{% endblock %}

