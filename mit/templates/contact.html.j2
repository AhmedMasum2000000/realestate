{% extends 'base.html.j2' %}
{% from 'components.html.j2' import eyebrow with context %}
{% block content %}
<section class="tool-intro wrap contact-intro">{{ eyebrow('YOUR NEXT CHAPTER BEGINS WITH A CONVERSATION') }}<h1>You bring the story.<br>We’ll help with <em>the plan.</em></h1><p>A free 15-minute first conversation about your move.<br>You don’t need every answer to get started.</p></section>
<section class="wrap contact-layout"><form id="move-enquiry" class="enquiry-form" action="{{ url('wp-json/mit/v1/enquiries') }}" method="post"><div class="form-heading"><span>01 / A LITTLE ABOUT YOU</span><p>Just enough to start a useful conversation.</p></div><div class="form-grid"><label for="enquiry-name">Your name<input id="enquiry-name" name="name" autocomplete="name" maxlength="120" required placeholder="What should we call you?"></label><label for="enquiry-email">Email address<input id="enquiry-email" name="email" type="email" autocomplete="email" maxlength="200" required placeholder="you@example.com"></label><label for="enquiry-phone">Phone or messaging number <span>Optional</span><input id="enquiry-phone" name="phone" type="tel" autocomplete="tel" maxlength="40" placeholder="Include your country code"></label><label for="enquiry-interest">What would you like help with?<select id="enquiry-interest" name="interest" required><option value="">Choose your starting point</option><option value="visa">Visa options</option><option value="dtv">DTV / remote work</option><option value="retirement">Retirement</option><option value="ltr">Long-Term Resident visa</option><option value="thailand-privilege">Thailand Privilege</option><option value="marriage">Marriage & family</option><option value="education">Study & activities</option><option value="homes">Renting or buying a home</option><option value="business">Business & investment</option><option value="care">Residency Care</option><option value="budget">My move budget</option><option value="fees">A written service quote</option><option value="privacy">A privacy request</option><option value="other">My whole move / still exploring</option></select></label></div><div class="form-heading"><span>02 / THE MOVE YOU HAVE IN MIND</span></div><div class="form-grid"><label for="enquiry-timeline">When are you thinking of moving?<select id="enquiry-timeline" name="timeline" required><option value="">Choose an approximate timeline</option><option value="soon">Within 3 months</option><option value="later">In 3–6 months</option><option value="year">In 6–12 months</option><option value="exploring">I’m still exploring</option><option value="already">I’m already in Thailand</option></select></label><label for="enquiry-budget">Monthly living budget <span>Optional · THB</span><input id="enquiry-budget" name="budget" type="number" min="0" max="10000000" placeholder="An estimate is enough"></label></div><label for="enquiry-message">Tell us a little about your plans<textarea id="enquiry-message" name="message" rows="4" maxlength="3000" placeholder="What brings you to Thailand? What is the main thing you would like to understand?"></textarea></label><p class="small">Please leave passports, bank statements and other sensitive documents out of this first message.</p><div class="honeypot" aria-hidden="true"><label>Leave this blank<input name="website" tabindex="-1" autocomplete="off"></label></div><label class="checkbox-label"><input name="consent" type="checkbox" required value="yes"><span>I agree to be contacted about my enquiry and have read the <a href="{{ url('privacy/') }}">privacy information</a>.</span></label><label class="checkbox-label"><input name="marketing" type="checkbox" value="yes"><span>Send me occasional Thailand moving updates. <span class="small">Optional. I can unsubscribe.</span></span></label><button class="button" type="submit">Let’s plan my next step {{ icon('arrow') }}</button><p id="enquiry-status" class="form-status" role="status" aria-live="polite"></p><noscript><p>This form needs JavaScript to submit securely. Enable JavaScript and reload this page.</p></noscript></form><aside class="contact-aside"><div class="contact-photo"><img src="{{ asset('coast.webp') }}" alt="Clear water and a quiet beach in Thailand" width="1440" height="810" loading="lazy"></div><div class="contact-note">{{ eyebrow('WHAT HAPPENS NEXT') }}<h2>A conversation.<br>Some clarity.<br>A next step.</h2><ol class="number-list"><li><strong>We read your priorities.</strong><p>Your timeline and the questions that matter to you.</p></li><li><strong>We arrange a first conversation.</strong><p>Confirm a suitable time and who will speak with you.</p></li><li><strong>You decide how to proceed.</strong><p>If you want paid support, ask for the scope and quote in writing first.</p></li></ol><p class="small">Visa approval and specialist legal outcomes are decided by the relevant authorities and professionals.</p><a class="text-link" href="{{ url('fees/') }}">Understand the fees {{ icon('arrow') }}</a><a class="text-link" data-whatsapp hidden href="#">Message us on WhatsApp {{ icon('arrow') }}</a></div></aside></section>
{% endblock %}
