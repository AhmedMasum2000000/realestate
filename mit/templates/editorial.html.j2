{% extends 'base.html.j2' %}
{% from 'components.html.j2' import eyebrow, faq, cta, sources, crumbs, rich_sections, next_step, related with context %}
{% block content %}
{{ crumbs(page, pages_by_slug) }}
<section class="page-hero wrap editorial-hero"><div>{{ eyebrow(page.eyebrow) }}<h1>{{ page.heading }}</h1><p>{{ page.intro|md }}</p><a class="button" href="{{ url('contact/?interest=' ~ page.slug.split('/')[0]) }}">Talk through my plans {{ icon('arrow') }}</a></div><div class="editorial-photo"><img src="{{ asset(page.image ~ '.webp') }}" alt="{{ 'A quiet Thai coast' if page.image == 'coast' else 'A home from our Pattaya property partner’s library' }}" width="1200" height="800"><span>{{ 'A LITTLE ROOM TO BEGIN AGAIN' if page.image == 'coast' else 'CHOOSE A HOME AROUND YOUR LIFE' }}</span></div></section>
{% if page.cards %}<section class="section soft-section compact-section"><div class="wrap related-grid">{% for title,text,href in page.cards %}<a class="related-card" href="{{ url(href) }}"><h2>{{ title }}</h2><p>{{ text }}</p><span class="text-link">Explore {{ icon('arrow') }}</span></a>{% endfor %}</div></section>{% endif %}
<section class="section"><div class="wrap article-layout"><article class="article-body">{{ rich_sections(page.sections) }}{{ next_step(page.next) }}{{ sources(page.sources) }}{% if page.slug=='living/moving-checklist' %}<div class="download-block"><h2>A plan to take with you.</h2><p>Save the branded moving checklist as a PDF, or print this guide.</p><div class="button-row"><a class="button" href="{{ asset('moving-checklist.pdf') }}" download>Download the checklist {{ icon('download') }}</a><button class="button button-outline" data-print>Print this guide {{ icon('external') }}</button></div></div>{% endif %}</article><aside class="article-sidebar"><div class="sidebar-card">{{ eyebrow('KEY FACTS' if page.checklist else 'SAVE YOURSELF THE RESEARCH') }}<h3>{{ page.checklist_title or ('A checklist to keep close.' if page.checklist else 'Get a plan built around you.') }}</h3>{% if page.checklist %}<ul class="check-list">{% for item in page.checklist %}<li>{{ icon('check') }}{{ item }}</li>{% endfor %}</ul>{% else %}<p>Tell us your situation once. We map the route, the documents and the costs, in writing.</p>{% endif %}<a class="button" href="{{ url('contact/?interest=' ~ page.slug.split('/')[0]) }}">Plan my move {{ icon('arrow') }}</a></div>{% if page.slug.startswith('homes') %}<div class="sidebar-note"><h3>Browse actual listings.</h3><p>See homes with our property partner. Confirm availability and prices for your own dates.</p><a href="https://pattayahomepro.com/" target="_blank" rel="noopener">Pattaya Home Pro {{ icon('external') }}</a></div>{% endif %}</aside></div></section>
{{ faq(page.faqs) }}{{ related(page.related) }}{{ cta() }}
{% endblock %}

