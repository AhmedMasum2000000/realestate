{% macro eyebrow(text) %}<p class="eyebrow"><span></span>{{ text }}</p>{% endmacro %}
{% macro faq(items) %}
{% if items %}<section class="section faq-section"><div class="wrap faq-layout"><div>{{ eyebrow('A LITTLE MORE CLARITY') }}<h2>Good questions.<br>Clear answers.</h2><p>The things worth knowing before you take the next step.</p></div><div class="faq-list">{% for question, answer in items %}<details><summary>{{ question }}<span aria-hidden="true">+</span></summary><p>{{ answer }}</p></details>{% endfor %}</div></div></section>{% endif %}
{% endmacro %}
{% macro cta(title='You don’t need every answer.<br>Just a clear next step.',text='Tell us where you are now and where you want to be. We’ll help put the decisions in order.') %}
<section class="closing"><div class="wrap closing-inner"><div>{{ eyebrow('LET’S MAKE IT FEEL POSSIBLE') }}<h2>{{ title|safe }}</h2><p>{{ text }}</p></div><div class="closing-action"><a class="button button-light" href="{{ url('contact/') }}">Plan my move {{ icon('arrow') }}</a><span>Start with a free 15-minute conversation.</span></div></div></section>
{% endmacro %}
{% macro sources(keys) %}
{% if keys %}<aside class="sources"><p class="eyebrow">OFFICIAL SOURCES · CHECKED {{ checked|upper }}</p><p>This is a planning overview. Check the requirements for your own circumstances with the responsible authority. Specialist legal or tax questions need qualified advice.</p><ul>{% for key in keys %}<li><a href="{{ source_map[key][1] }}" target="_blank" rel="noopener">{{ source_map[key][0] }} {{ icon('external') }}</a></li>{% endfor %}</ul></aside>{% endif %}
{% endmacro %}

