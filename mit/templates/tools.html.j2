{% extends 'base.html.j2' %}
{% from 'components.html.j2' import eyebrow, cta with context %}
{% block content %}
<section class="page-hero wrap"><div>{{ eyebrow('USEFUL ANSWERS, BEFORE THE CALL') }}<h1>A little less guesswork.<br>A lot more <em>clarity.</em></h1><p>Explore your visa routes, build a budget and prepare the right property questions. These tools work without an account or an email wall.</p></div><div class="page-hero-note">{{ icon('compass') }}<h2>A starting point<br>you can use.</h2><p>Change the assumptions. Read the sources. Bring the questions to your next conversation.</p></div></section>
<section class="section soft-section"><div class="wrap tool-grid">{% for title,label,text,path,icon_name in [('Visa Finder','START WITH YOUR ROUTE','Answer a few questions and get options to explore, with the conditions worth checking next.','tools/visa-finder/','passport'),('Move budget calculator','PUT THE COSTS TOGETHER','Change the monthly and arrival assumptions to fit your own plans.','tools/cost-calculator/','receipt'),('Ownership checklist','BEFORE A PROPERTY COMMITMENT','Compare the questions to ask for a condo, lease or proposed company purchase.','tools/ownership-checker/','home'),('Moving checklist','FROM BEFORE THE FLIGHT TO WEEK ONE','Download a practical checklist and put the next steps in order.','living/moving-checklist/','check')] %}<a class="tool-card" href="{{ url(path) }}"><span class="tool-art">{{ icon(icon_name) }}</span><span class="eyebrow">{{ label }}</span><h2>{{ title }}</h2><p>{{ text }}</p><span class="text-link">Open the tool {{ icon('arrow') }}</span></a>{% endfor %}</div></section>{{ cta() }}
{% endblock %}

