{% extends "base.html.j2" %}
{%- from "macros.html.j2" import crumbs_nav, section_body, faq_block, next_step, card, home_card %}
{% block content %}
{{ crumbs_nav(crumbs, page) }}
<header class="phead">
  <div class="wrap">
    {%- if page.kicker %}<span class="kick">{{ page.kicker }}</span>{% endif %}
    <h1 class="rv">{{ page.h1 }}</h1>
    {%- if page.lead %}<p class="lead rv rv-1">{{ page.lead|md }}</p>{% endif %}
    {%- if page.verified %}<div class="phead__meta"><span class="badge"><i></i>Checked {{ page.verified }}</span></div>{% endif %}
  </div>
</header>

<div class="wrap" style="padding-block:clamp(2.4rem,5vw,4rem)">
  {%- if page.groups %}
    {%- for g in page.groups %}
    <section class="rv" style="margin-top:{{ '0' if loop.first else 'clamp(2.6rem,5vw,4rem)' }}">
      <h2 class="d3" style="color:var(--teal)">{{ g.title }}</h2>
      {%- if g.intro %}<p class="lead" style="max-width:62ch;margin-top:.8rem">{{ g.intro|md }}</p>{% endif %}
      <div class="cards">{% for href in g["items"] %}{{ card(pages[href]) }}{% endfor %}</div>
    </section>
    {%- endfor %}
  {%- elif page._children %}
    <div class="cards">{% for c in page._children %}{{ card(c) }}{% endfor %}</div>
  {%- endif %}

  {%- if page.sections %}
  <div class="prose" style="margin-top:clamp(2.6rem,5vw,4rem)">
    {%- for s in page.sections %}
    <section id="{{ s._id }}">{% if s.h2 %}<h2>{{ s.h2 }}</h2>{% endif %}{{ section_body(s) }}</section>
    {%- endfor %}
  </div>
  {%- endif %}

  {%- if page.show_homes and homes %}
  <section style="margin-top:clamp(2.6rem,5vw,4rem)">
    <span class="kick">From our partner, Pattaya Home Pro</span>
    <h2 class="d3" style="color:var(--teal)">Homes you can view this month</h2>
    <div class="grid rv">{% for h in homes %}{{ home_card(h) }}{% endfor %}</div>
    <p style="margin-top:1.4rem"><a class="btn btn--teal" href="{{ partner_url }}/properties/" rel="noopener">See every listing</a></p>
  </section>
  {%- endif %}

  {%- if page.faq %}
  <section class="prose" id="faq" style="margin-top:clamp(2.6rem,5vw,4rem)"><h2>Questions people ask</h2>{{ faq_block(page.faq) }}</section>
  {%- endif %}
  <div style="max-width:72ch">{{ next_step(next) }}</div>
</div>
{% endblock %}
