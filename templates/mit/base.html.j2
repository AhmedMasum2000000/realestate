<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<script>document.documentElement.className+=' js';</script>
<title>{{ page_title }}</title>
<meta name="description" content="{{ page_description }}">
<link rel="canonical" href="{{ site_url }}{{ page_path }}">
{%- if preview or page.noindex %}
<meta name="robots" content="noindex,follow">
{%- else %}
<meta name="robots" content="index,follow,max-image-preview:large">
{%- endif %}
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ brand.name }}">
<meta property="og:title" content="{{ page_title }}">
<meta property="og:description" content="{{ page_description }}">
<meta property="og:url" content="{{ site_url }}{{ page_path }}">
<meta property="og:image" content="{{ site_url }}/assets/brand/{{ site.og_image }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="{{ palette.teal }}">
{%- if gsc_meta %}
<meta name="google-site-verification" content="{{ gsc_meta }}">
{%- endif %}
<link rel="icon" href="/assets/brand/favicon.svg" type="image/svg+xml">
<link rel="preload" href="/assets/brand/fonts/archivo-700.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/brand/fonts.css">
<link rel="stylesheet" href="/assets/site.css">
{%- if jsonld %}
<script type="application/ld+json">{{ jsonld }}</script>
{%- endif %}
</head>
<body class="{{ body_class }}">
<a class="skip" href="#main">Skip to content</a>
{%- from "macros.html.j2" import wordmark, arrow, wa %}

<header class="nav">
  <div class="wrap nav__in">
    <a class="nav__brand" href="/" aria-label="{{ brand.name }} home">{{ wordmark(brand) }}</a>
    <a class="nav__phone" href="{{ wa(brand, 'Hi, I am planning a move to Thailand.') }}" rel="noopener">WhatsApp us</a>
    <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="menu">
      <span class="nav__toggle-l">Menu</span>
      <span class="nav__bars" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>
</header>

<div class="menu" id="menu" aria-hidden="true">
  <div class="wrap menu__top">
    {{ wordmark(brand) }}
    <button class="menu__close" type="button" aria-label="Close menu"><span aria-hidden="true">&times;</span></button>
  </div>
  <nav class="wrap menu__nav" aria-label="Main">
    {%- for item in menu %}
    <a href="{{ item.href }}"{% if nav_current and item.href.strip('/') == nav_current %} aria-current="page"{% endif %} style="--i:{{ loop.index0 }}">
      <span class="menu__line"><span>{{ item.label }}</span></span>{{ arrow() }}
    </a>
    {%- endfor %}
  </nav>
  <div class="wrap menu__foot">
    <a class="menu__phone" href="tel:{{ brand.phone_href }}">{{ brand.phone_display }}</a>
    <p>{{ brand.address_street }}, {{ brand.address_locality }}, {{ brand.address_region }} {{ brand.address_postal }}</p>
  </div>
</div>

<main id="main">
{%- block content %}{% endblock %}
</main>

<footer class="foot">
  <div class="wrap">
    {{ wordmark(brand) }}
    <span class="kick" style="color:var(--coral);margin-top:2.4rem">A real person replies, usually within 15 minutes in office hours</span>
    <a class="foot__cta" href="{{ wa(brand, 'Hi, I am planning a move to Thailand.') }}" rel="noopener">WhatsApp {{ brand.phone_display }}</a>
    <div class="foot__grid">
      {%- for col in site.footer %}
      <div>
        <h4>{{ col.title }}</h4>
        <ul>
          {%- for href in col.links %}
          {%- set p = pages[href] %}
          <li><a href="{{ href }}">{{ p.short or (p.h1|plain) }}</a></li>
          {%- endfor %}
        </ul>
      </div>
      {%- endfor %}
      <div>
        <h4>Office</h4>
        <ul>
          <li>{{ brand.address_street }}</li>
          <li>{{ brand.address_locality }}, {{ brand.address_region }} {{ brand.address_postal }}</li>
          <li><a href="tel:{{ brand.phone_href }}">{{ brand.phone_display }}</a></li>
          <li>Property partner: <a href="{{ partner_url }}/" rel="noopener">Pattaya Home Pro</a></li>
        </ul>
      </div>
    </div>
    <div class="foot__legal">
      <span>&copy; {{ year }} {{ brand.name }}. {{ brand.tagline }}.</span>
      <span>Visa decisions are made by Thai authorities. Legal steps are handled by licensed lawyers. <a href="/privacy/">Privacy</a></span>
    </div>
  </div>
</footer>

<a class="callbar" href="{{ wa(brand, 'Hi, I am planning a move to Thailand.') }}" rel="noopener">WhatsApp us · free 15-min call</a>

<script src="/assets/site.js" defer></script>
</body>
</html>
