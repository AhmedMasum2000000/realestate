{% extends "base.html.j2" %}
{%- from "macros.html.j2" import crumbs_nav, section_body, faq_block, next_step, card, wa %}
{% block content %}
{{ crumbs_nav(crumbs, page) }}
<header class="phead">
  <div class="wrap">
    {%- if page.kicker %}<span class="kick">{{ page.kicker }}</span>{% endif %}
    <h1 class="rv">{{ page.h1 }}</h1>
    {%- if page.lead %}<p class="lead rv rv-1">{{ page.lead|md }}</p>{% endif %}
    <div class="phead__meta">
      {%- if page.verified %}<span class="badge"><i></i>Checked {{ page.verified }}</span>{% endif %}
      {%- if page.for %}<span>For: {{ page.for }}</span>{% endif %}
    </div>
  </div>
</header>

<div class="wrap guide">
  <article class="prose">
    {%- if page.facts %}
    <div class="kfacts">{% for f in page.facts %}<div><b>{{ f.v }}</b><span>{{ f.k }}</span></div>{% endfor %}</div>
    {%- endif %}
    {%- for s in page.sections %}
    <section id="{{ s._id }}">
      {%- if s.h2 %}<h2>{{ s.h2 }}</h2>{% endif %}
      {{ section_body(s) }}
    </section>
    {%- endfor %}
    {%- if page.faq %}
    <section id="faq"><h2>Questions people ask</h2>{{ faq_block(page.faq) }}</section>
    {%- endif %}
    {%- if page.sources %}
    <section class="sources" id="sources"><h3>Official sources</h3>
      <ul>{% for s in page.sources %}<li><a href="{{ s.url }}" rel="noopener" target="_blank">{{ s.label }}</a></li>{% endfor %}</ul>
      <p>Rules and fees change. We re-check each guide regularly; confirm the current position with the authority or with us before you pay or travel.</p>
    </section>
    {%- endif %}
    {{ next_step(next) }}
  </article>

  <aside class="side">
    {%- if page.sections|length > 2 %}
    <nav class="toc" aria-label="On this page"><b>On this page</b>
      <ol>{% for s in page.sections if s.h2 %}<li><a href="#{{ s._id }}">{{ s.toc or s.h2 }}</a></li>{% endfor %}{% if page.faq %}<li><a href="#faq">Questions</a></li>{% endif %}</ol>
    </nav>
    {%- endif %}
    <div class="ask">
      <b>{{ page.ask or "Not sure this fits you?" }}</b>
      <p>Tell us your situation. A case manager replies with the route that fits and a fixed fee, before you pay anything.</p>
      <a class="btn btn--coral" href="{{ wa(brand, 'Hi, I read your guide: ' ~ (page.short or (page.h1|plain)) ~ '. My situation is: ') }}" rel="noopener">Ask on WhatsApp</a>
      <a class="btn btn--ghost" href="/tools/visa-finder/" style="color:#fff">Try the Visa Finder</a>
    </div>
  </aside>
</div>

{%- if related %}
<section class="sec" style="background:var(--paper-2);padding-block:clamp(3rem,6vw,4.5rem)">
  <div class="wrap">
    <span class="kick">Keep going</span>
    <h2 class="d2" style="color:var(--teal)">Related guides</h2>
    <div class="cards">{% for r in related %}{{ card(r) }}{% endfor %}</div>
  </div>
</section>
{%- endif %}
{% endblock %}
