/* Move In Thailand: menu, motion and tools.
   Everything here is enhancement: the page is complete and readable with this
   file blocked, and every effect is skipped outright under reduced-motion. */
(function () {
  "use strict";

  var reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  var root = document.documentElement;

  /* ---------- full-screen menu ---------- */
  var menu = document.getElementById("menu");
  var toggle = document.querySelector(".nav__toggle");

  if (menu && toggle) {
    var closer = menu.querySelector(".menu__close");
    var lastFocus = null;

    var setMenu = function (open) {
      root.classList.toggle("menu-open", open);
      menu.setAttribute("aria-hidden", String(!open));
      toggle.setAttribute("aria-expanded", String(open));
      if (open) {
        lastFocus = document.activeElement;
        // Wait for the panel to be painted before moving focus into it.
        requestAnimationFrame(function () { closer && closer.focus(); });
      } else if (lastFocus) {
        lastFocus.focus();
      }
    };

    toggle.addEventListener("click", function () {
      setMenu(!root.classList.contains("menu-open"));
    });
    closer && closer.addEventListener("click", function () { setMenu(false); });

    menu.addEventListener("click", function (e) {
      if (e.target.closest("a")) setMenu(false);
    });

    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape" && root.classList.contains("menu-open")) setMenu(false);
    });

    // Keep tabbing inside the panel while it is open.
    menu.addEventListener("keydown", function (e) {
      if (e.key !== "Tab") return;
      var items = menu.querySelectorAll("a[href], button");
      if (!items.length) return;
      var first = items[0], last = items[items.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    });
  }

  /* ---------- reveals ---------- */
  var reveal = function () {
    var nodes = document.querySelectorAll(".rv");
    if (reduced || !("IntersectionObserver" in window)) {
      for (var i = 0; i < nodes.length; i++) nodes[i].classList.add("in");
      return;
    }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); }
      });
    }, { threshold: 0.08, rootMargin: "0px 0px -6% 0px" });

    nodes.forEach(function (n) { io.observe(n); });

    // Safety net: never leave anything stranded at opacity 0.
    setTimeout(function () {
      document.querySelectorAll(".rv:not(.in)").forEach(function (n) {
        if (n.getBoundingClientRect().top < innerHeight * 1.2) n.classList.add("in");
      });
    }, 2400);
  };
  reveal();

  if (reduced) return;

  /* ---------- scroll-linked hero ----------
     The headline is split in two and the halves diverge as the hero scrolls
     away, which is the reference site's signature move. Driven off scroll
     position rather than a timed animation so it tracks the wheel exactly. */
  var hero = document.querySelector("[data-hero]");
  if (hero) {
    var halves = hero.querySelectorAll("[data-hero-l], [data-hero-r]");
    var media = hero.querySelector("[data-hero-media]");
    var inner = hero.querySelector("[data-hero-in]");
    var ticking = false;

    var frame = function () {
      ticking = false;
      // The headline wraps on narrow screens, so sliding the halves apart
      // would just drag wrapped text off-screen. Fade only.
      var wide = innerWidth > 736;
      var height = hero.offsetHeight || 1;
      var p = Math.min(Math.max(window.scrollY / height, 0), 1);
      var eased = p * p; // hold still early, accelerate as it leaves

      halves.forEach(function (el) {
        var dir = el.hasAttribute("data-hero-l") ? -1 : 1;
        el.style.transform = wide
          ? "translate3d(" + (dir * eased * 42) + "vw,0,0)"
          : "none";
      });
      if (inner) inner.style.opacity = String(1 - p * 1.15);
      if (media) media.style.transform = "translate3d(0," + (p * 14) + "%,0) scale(" + (1 + p * 0.12) + ")";
    };

    var onScroll = function () {
      if (!ticking) { ticking = true; requestAnimationFrame(frame); }
    };
    addEventListener("scroll", onScroll, { passive: true });
    addEventListener("resize", onScroll);
    frame();
  }

  /* ---------- sticky nav state ---------- */
  var nav = document.querySelector(".nav");
  if (nav) {
    var lastY = 0, navTick = false;
    var navFrame = function () {
      navTick = false;
      var y = window.scrollY;
      nav.classList.toggle("nav--solid", y > 24);
      // Give the page back when scrolling down, bring the nav back on the way up.
      nav.classList.toggle("nav--hide", y > 420 && y > lastY && !root.classList.contains("menu-open"));
      lastY = y;
    };
    addEventListener("scroll", function () {
      if (!navTick) { navTick = true; requestAnimationFrame(navFrame); }
    }, { passive: true });
    navFrame();
  }
})();

/* ---------- tools ----------
   They work without motion and without storage. The answers are guidance to
   start a conversation, never a decision: every result says so. */
(function () {
  "use strict";
  var WA = "{{ brand.whatsapp }}";
  var wa = function (text) { return "https://wa.me/" + WA + "?text=" + encodeURIComponent(text); };
  var esc = function (s) { var d = document.createElement("div"); d.textContent = s; return d.innerHTML; };
  var fmt = function (n) { return Math.round(n / 500) * 500; };
  var thb = function (n) { return fmt(n).toLocaleString("en-US"); };

  /* Visa Finder */
  var vf = document.querySelector("[data-visa-finder]");
  if (vf) {
    var ROUTES = {
      retirement: { name: "Retirement visa (Non-O, then yearly extensions)", href: "/visas/retirement/",
        why: "Age 50+, with 800,000 THB in a Thai bank or 65,000 THB a month in income." },
      ltrPension: { name: "LTR visa: Wealthy Pensioner", href: "/visas/ltr/",
        why: "10 years, one yearly address report instead of 90-day reports, if your pension or passive income is high enough." },
      dtv: { name: "Destination Thailand Visa (DTV)", href: "/visas/dtv/",
        why: "5 years, 180 days per entry, for remote workers and soft-power students with 500,000 THB in savings." },
      ltrPro: { name: "LTR visa: Work-from-Thailand or Highly-Skilled Professional", href: "/visas/ltr/",
        why: "10 years with a digital work permit and fewer reports, for higher earners." },
      marriage: { name: "Marriage or family visa (Non-O)", href: "/visas/marriage/",
        why: "For spouses and parents of Thai nationals: 400,000 THB in the bank or 40,000 THB a month." },
      family: { name: "Thai child, dependent and guardian visas", href: "/visas/family/",
        why: "For parents of Thai children, dependants of visa holders and parents of students." },
      nonb: { name: "Business visa (Non-B) and work permit", href: "/visas/business/",
        why: "To work for or run a Thai company. The company has to meet capital and staffing rules." },
      education: { name: "Education visa (Non-ED)", href: "/visas/education/",
        why: "For enrolled students at a licensed school or university." },
      privilege: { name: "Thailand Privilege membership", href: "/visas/thailand-privilege/",
        why: "Pay once, stay 5 to 20 years with no income test and VIP airport help." },
      ltrWealth: { name: "LTR visa: Wealthy Global Citizen", href: "/visas/ltr/",
        why: "For people with large assets who invest in Thailand." },
      tourist: { name: "Visa exemption or tourist visa, while you plan", href: "/visas/tourist-and-visa-exemption/",
        why: "A short stay to view homes and areas before you commit to a long-stay route." }
    };
    vf.addEventListener("submit", function (e) {
      e.preventDefault();
      var f = new FormData(vf), age = f.get("age"), why = f.get("why"),
          cash = +f.get("cash"), inc = +f.get("inc"), priv = f.get("priv") === "yes";
      var pick = [];
      var add = function (k) { if (pick.indexOf(k) < 0) pick.push(k); };
      // The DTV needs remote work or a soft-power activity, so it is never
      // offered for retirement or living on wealth alone.
      if (why === "retire") {
        if (age === "50") { if (cash >= 800 || inc >= 40) add("retirement"); if (inc >= 80) add("ltrPension"); }
        else if (cash >= 3000 || inc >= 80) add("ltrWealth");
      }
      if (why === "remote") { if (cash >= 500) add("dtv"); if (inc >= 80) add("ltrPro"); }
      if (why === "family") { add("marriage"); add("family"); }
      if (why === "work") { add("nonb"); if (inc >= 80) add("ltrPro"); }
      if (why === "study") { add("education"); if (cash >= 500) add("dtv"); }
      if (why === "wealth") { if (cash >= 3000 || inc >= 80) add("ltrWealth"); if (age === "50" && cash >= 800) add("retirement"); }
      if (priv) add("privilege");
      if (!pick.length) add("tourist");
      var res = vf.querySelector("[data-result]");
      var summary = "Visa Finder answers: age " + (age === "50" ? "50+" : "under 50") + ", reason " + why +
        ", savings band " + cash + "k THB, income band " + inc + "k USD. Shortlist: " +
        pick.map(function (k) { return ROUTES[k].name; }).join("; ");
      res.innerHTML = "<h3>Your starting shortlist</h3><ul>" + pick.map(function (k) {
        var r = ROUTES[k];
        return '<li><a href="' + r.href + '">' + esc(r.name) + "</a>: " + esc(r.why) + "</li>";
      }).join("") + "</ul><p style=\"margin:0 0 1rem\">This is a starting point, not a decision. Embassies and immigration offices decide, and details such as your nationality change the answer.</p>" +
        '<a class="btn btn--coral" href="' + wa("Hi! " + summary + ". Can you confirm which fits me?") + '" rel="noopener">Check it with a case manager</a>';
      res.hidden = false;
      res.scrollIntoView({ behavior: "smooth", block: "nearest" });
    });
  }

  /* Cost calculator */
  var cc = document.querySelector("[data-cost-calc]");
  if (cc) {
    var calc = function () {
      var f = new FormData(cc), city = +f.get("city"), who = +f.get("who"),
          home = +f.get("home"), life = +f.get("life");
      var adults = Math.min(who, 2), kids = Math.max(who - 2, 0);
      var food = [9000, 15000, 28000][life] * adults + [5000, 8000, 14000][life] * kids;
      var lines = [
        ["Rent", home * city],
        ["Electricity, water, internet", (2500 + 1500 * adults) * (life + 1) * 0.7],
        ["Food and eating out", food * (city > 1 ? 1.1 : 1)],
        ["Getting around", [2000, 5000, 12000][life] * (adults > 1 ? 1.4 : 1)],
        ["Health insurance", [3000, 5000, 9000][life] * adults + 2500 * kids],
        ["Phone, gym, leisure", [4000, 10000, 25000][life] * (adults > 1 ? 1.5 : 1)]
      ];
      if (kids) lines.push(["International school (from)", 30000 * kids]);
      var total = lines.reduce(function (a, l) { return a + l[1]; }, 0);
      cc.querySelector("[data-lines]").innerHTML = lines.map(function (l) {
        return "<tr><td>" + l[0] + "</td><td>" + thb(l[1]) + "</td></tr>";
      }).join("") + "<tr><td><b>Total</b></td><td><b>" + thb(total) + "</b></td></tr>";
      cc.querySelector("[data-total]").textContent = "About " + thb(total) + " THB a month";
    };
    cc.addEventListener("change", calc);
    calc();
  }

  /* Ownership checker */
  var oc = document.querySelector("[data-own-check]");
  if (oc) {
    oc.addEventListener("submit", function (e) {
      e.preventDefault();
      var f = new FormData(oc), what = f.get("what"), who = f.get("who"), funds = f.get("funds");
      var out = [], ok = true;
      if (what === "condo" && who === "me") {
        out.push("Yes: a foreigner can own a condo unit outright, in their own name, as long as the building's foreign quota (49% of floor area) is not used up.");
        if (funds !== "abroad") { ok = false; out.push("The money has to arrive from abroad in foreign currency, with the bank's foreign-exchange record for the Land Office. Money already in Thailand usually does not qualify unless it came in that way."); }
      } else if (what === "condo") {
        out.push("You can buy a condo in your own name, so a spouse's name or a company is rarely needed. Ask why before you choose a more complicated route.");
      }
      if (what === "house" || what === "land") {
        ok = false;
        out.push("Foreigners cannot own land in their own name. The usual legal routes are a registered lease of the land (up to 30 years) while you own the house itself, or other registered rights such as a superficies or usufruct.");
      }
      if (who === "spouse") out.push("A Thai spouse can own the land. You will sign a declaration at the Land Office that the money is theirs, so the property is legally theirs.");
      if (who === "company") { ok = false; out.push("A Thai company can own land only if Thai shareholders genuinely own the majority and invest their own money. Using Thai nominees is a crime, and the authorities are actively checking these companies in 2026."); }
      if (what === "biz") out.push("For business premises, most foreign-owned businesses lease. Buying usually needs a properly structured company: BOI promotion, a Foreign Business Licence or, for US citizens, the Treaty of Amity.");
      var res = oc.querySelector("[data-result]");
      res.innerHTML = "<h3>" + (ok ? "Looks possible" : "Possible, with the right structure") + "</h3><ul>" +
        out.map(function (x) { return "<li>" + esc(x) + "</li>"; }).join("") +
        "</ul><p style=\"margin:0 0 1rem\">General information, not legal advice. A licensed lawyer should check the title deed and the contract before you pay a deposit.</p>" +
        '<a class="btn btn--coral" href="' + wa("Hi, I used the ownership checker: buying " + what + " in " + who + " name, funds " + funds + ". Can you advise?") + '" rel="noopener">Ask about my purchase</a>';
      res.hidden = false;
    });
  }

  /* Contact form: composes a WhatsApp message; nothing is sent to this site. */
  var wf = document.querySelector("[data-wa-form]");
  if (wf) {
    wf.addEventListener("submit", function (e) {
      e.preventDefault();
      var f = new FormData(wf);
      var text = "Hi, I'm " + (f.get("name") || "") + (f.get("from") ? " from " + f.get("from") : "") +
        ". I need help with: " + f.get("topic") + ". Timing: " + f.get("when") + "." +
        (f.get("msg") ? " " + f.get("msg") : "");
      window.open(wa(text), "_blank", "noopener");
    });
  }
})();
