{% extends "base.html.j2" %}
{%- from "macros.html.j2" import crumbs_nav, section_body, faq_block, next_step, wa %}
{% block content %}
{{ crumbs_nav(crumbs, page) }}
<header class="phead">
  <div class="wrap">
    <span class="kick">{{ page.kicker }}</span>
    <h1 class="rv">{{ page.h1 }}</h1>
    <p class="lead rv rv-1">{{ page.lead|md }}</p>
  </div>
</header>

<div class="wrap guide">
  <div>
  {%- if page.tool == "visa" %}
    <form class="tool" data-visa-finder>
      <fieldset class="q"><legend>1. How old are you?</legend><div class="opts">
        <label><input type="radio" name="age" value="u50" required> Under 50</label>
        <label><input type="radio" name="age" value="50"> 50 or over</label></div></fieldset>
      <fieldset class="q"><legend>2. What is the main reason for your move?</legend><div class="opts">
        <label><input type="radio" name="why" value="retire" required> Retire</label>
        <label><input type="radio" name="why" value="remote"> Work remotely for clients or a company abroad</label>
        <label><input type="radio" name="why" value="family"> Be with my Thai spouse or child</label>
        <label><input type="radio" name="why" value="work"> Work for, or run, a business in Thailand</label>
        <label><input type="radio" name="why" value="study"> Study, or train in Muay Thai, cooking or language</label>
        <label><input type="radio" name="why" value="wealth"> Live here on my own wealth or investments</label></div></fieldset>
      <fieldset class="q"><legend>3. Savings you could show in a bank account</legend><div class="opts">
        <label><input type="radio" name="cash" value="0" required> Under 500,000 THB</label>
        <label><input type="radio" name="cash" value="500"> 500,000 to 800,000 THB</label>
        <label><input type="radio" name="cash" value="800"> 800,000 THB to 3 million</label>
        <label><input type="radio" name="cash" value="3000"> Over 3 million THB</label></div></fieldset>
      <fieldset class="q"><legend>4. Your yearly income or pension</legend><div class="opts">
        <label><input type="radio" name="inc" value="0" required> Under US$40,000</label>
        <label><input type="radio" name="inc" value="40"> US$40,000 to 80,000</label>
        <label><input type="radio" name="inc" value="80"> Over US$80,000</label></div></fieldset>
      <fieldset class="q"><legend>5. Would you pay a one-off membership fee (from 900,000 THB) for a no-paperwork long stay?</legend><div class="opts">
        <label><input type="radio" name="priv" value="yes" required> Yes, if it saves hassle</label>
        <label><input type="radio" name="priv" value="no"> No</label></div></fieldset>
      <button class="btn btn--teal" type="submit">Show my shortlist</button>
      <div class="result" data-result hidden aria-live="polite"></div>
    </form>
  {%- elif page.tool == "cost" %}
    <form class="tool" data-cost-calc>
      <div class="form__row">
        <div class="field"><label for="c-city">City</label><select id="c-city" name="city">
          <option value="1">Pattaya and Jomtien</option><option value="1.3">Bangkok (central)</option><option value="1.25">Phuket</option><option value="0.8">Chiang Mai</option><option value="1.0">Hua Hin</option></select></div>
        <div class="field"><label for="c-who">Who is moving</label><select id="c-who" name="who">
          <option value="1">Just me</option><option value="2" selected>A couple</option><option value="4">A family of four</option></select></div>
      </div>
      <div class="form__row">
        <div class="field"><label for="c-home">Home</label><select id="c-home" name="home">
          <option value="15000">1-bed condo</option><option value="30000" selected>2-bed condo</option><option value="45000">House with garden</option><option value="90000">Pool villa</option></select></div>
        <div class="field"><label for="c-life">Lifestyle</label><select id="c-life" name="life">
          <option value="0">Simple: cook at home, baht buses</option><option value="1" selected>Comfortable: eat out often, own scooter</option><option value="2">Premium: car, international dining</option></select></div>
      </div>
      <p class="total" data-total aria-live="polite">&nbsp;</p>
      <div class="tbl"><table><thead><tr><th scope="col">Per month</th><th scope="col">Estimate (THB)</th></tr></thead><tbody data-lines></tbody></table></div>
      <p class="note">Estimates in Thai baht for 2026, from typical prices our clients pay. Your lease, school fees and habits move the total more than anything else.</p>
    </form>
  {%- elif page.tool == "own" %}
    <form class="tool" data-own-check>
      <fieldset class="q"><legend>1. What do you want to buy?</legend><div class="opts">
        <label><input type="radio" name="what" value="condo" required> A condo</label>
        <label><input type="radio" name="what" value="house"> A house with its land</label>
        <label><input type="radio" name="what" value="land"> Land to build on</label>
        <label><input type="radio" name="what" value="biz"> Premises for a business</label></div></fieldset>
      <fieldset class="q"><legend>2. Whose name would it be in?</legend><div class="opts">
        <label><input type="radio" name="who" value="me" required> Mine</label>
        <label><input type="radio" name="who" value="spouse"> My Thai spouse's</label>
        <label><input type="radio" name="who" value="company"> A Thai company</label></div></fieldset>
      <fieldset class="q"><legend>3. Will the money come from outside Thailand?</legend><div class="opts">
        <label><input type="radio" name="funds" value="abroad" required> Yes, transferred from abroad</label>
        <label><input type="radio" name="funds" value="local"> No, it is already in Thailand</label></div></fieldset>
      <button class="btn btn--teal" type="submit">Check what's possible</button>
      <div class="result" data-result hidden aria-live="polite"></div>
    </form>
  {%- endif %}

    <div class="prose" style="margin-top:2.6rem">
      {%- for s in page.sections %}<section id="{{ s._id }}">{% if s.h2 %}<h2>{{ s.h2 }}</h2>{% endif %}{{ section_body(s) }}</section>{% endfor %}
      {%- if page.faq %}<section id="faq"><h2>Questions people ask</h2>{{ faq_block(page.faq) }}</section>{% endif %}
      {{ next_step(next) }}
    </div>
  </div>
  <aside class="side">
    <div class="ask">
      <b>Want a person to check it?</b>
      <p>Send us your answers. A case manager confirms the route, the documents and a fixed fee.</p>
      <a class="btn btn--coral" href="{{ wa(brand, 'Hi, I used your ' ~ (page.short or (page.h1|plain)) ~ '. Can you check my situation?') }}" rel="noopener">Ask on WhatsApp</a>
    </div>
  </aside>
</div>
{% endblock %}
