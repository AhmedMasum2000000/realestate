/* Move In Thailand
   Brutalist-editorial: oversized uppercase display type that bleeds past the
   viewport, hard-edged full-bleed colour blocks, flat cards, wide gutters.
   Motion is scroll-linked rather than timed, so it tracks the wheel. */

:root{
  --teal:{{ palette.teal }}; --teal-2:{{ palette.teal_2 }}; --teal-3:{{ palette.teal_3 }};
  --coral:{{ palette.coral }}; --coral-2:{{ palette.coral_2 }}; --coral-3:{{ palette.coral_3 }};
  --ink:{{ palette.ink }}; --ink-2:{{ palette.ink_2 }}; --muted:{{ palette.muted }};
  --paper:{{ palette.paper }}; --paper-2:{{ palette.paper_2 }}; --paper-3:{{ palette.paper_3 }};
  --rule:{{ palette.rule }};
  --display:{{ fonts.display_stack }};
  --body:{{ fonts.body_stack }};
  --ease:cubic-bezier(.22,1,.36,1);
  --swift:cubic-bezier(.16,1,.3,1);
  --gut:clamp(1.15rem,4vw,4rem);
  --sec:clamp(4rem,9vw,7.5rem);
  --nav-h:4.6rem;
}

*,*::before,*::after{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
html.menu-open{overflow:hidden}
body{
  margin:0;background:var(--paper);color:var(--ink);
  font-family:var(--body);font-size:17px;line-height:1.62;font-weight:300;
  -webkit-font-smoothing:antialiased;overflow-x:hidden;
}
img,svg,video{max-width:100%;display:block}
a{color:inherit;text-decoration:none}
button,input,select,textarea{font:inherit;color:inherit}
:focus-visible{outline:3px solid var(--coral);outline-offset:3px}

/* ---------- type ---------- */
h1,h2,h3,h4,.disp{
  font-family:var(--display);font-weight:700;text-transform:uppercase;
  line-height:.92;letter-spacing:-.03em;margin:0;text-wrap:balance;
}
.d1{font-size:clamp(2.6rem,9vw,8rem);line-height:.9}
.d2{font-size:clamp(1.7rem,3.3vw,3rem)}
.d3{font-size:clamp(1.4rem,2.5vw,2.1rem)}
.d4{font-size:clamp(1.05rem,1.5vw,1.3rem);letter-spacing:-.01em}
.kick{
  font-family:var(--display);font-size:.72rem;font-weight:600;
  text-transform:uppercase;letter-spacing:.2em;color:var(--coral-3);
  display:block;margin-bottom:1.4rem;
}
.lead{font-size:clamp(1.02rem,1.35vw,1.2rem);color:var(--ink-2);max-width:46ch;font-weight:300}
.tnum{font-variant-numeric:tabular-nums}

/* ---------- layout ---------- */
.wrap{max-width:86rem;margin:0 auto;padding-inline:var(--gut);width:100%}
.sec{padding-block:var(--sec)}
.block{background:var(--teal);color:var(--paper)}
.block .kick{color:var(--coral)}
.block .lead{color:#BFD6DA}
.bar{height:1px;background:var(--rule);border:0;margin:0}

/* ---------- nav ---------- */
.nav{position:fixed;top:0;left:0;right:0;z-index:60;
  transition:background .4s var(--ease),transform .5s var(--swift),border-color .4s}
.nav::after{content:"";position:absolute;inset:0;background:var(--paper);
  opacity:0;transition:opacity .4s var(--ease);z-index:-1;
  border-bottom:1px solid var(--rule)}
.nav--solid::after{opacity:1}
.nav--hide{transform:translateY(-100%)}
.nav__in{display:flex;align-items:center;gap:1.2rem;height:var(--nav-h)}
.nav__brand{flex:none;display:block}
.nav__brand img{height:clamp(1.7rem,3.1vw,2.3rem);width:auto}
.nav__phone{margin-left:auto;font-family:var(--display);font-weight:700;
  font-size:.92rem;letter-spacing:.04em;color:var(--teal);
  padding:.6rem 1.1rem;border:2px solid var(--teal);
  transition:background .25s,color .25s}
.nav__phone:hover{background:var(--teal);color:var(--paper)}
.nav__toggle{display:inline-flex;align-items:center;gap:.65rem;background:none;
  border:0;cursor:pointer;padding:.5rem 0 .5rem .4rem;color:var(--teal)}
.nav__toggle-l{font-family:var(--display);font-weight:700;font-size:.8rem;
  text-transform:uppercase;letter-spacing:.16em}
.nav__bars{display:block;width:26px}
.nav__bars i{display:block;height:2px;background:currentColor;
  transition:transform .35s var(--ease),width .35s var(--ease)}
.nav__bars i+i{margin-top:6px;width:17px;margin-left:auto}
.nav__toggle:hover .nav__bars i+i{width:26px}
@media(max-width:34rem){.nav__phone{display:none}}

/* The nav is fixed, so anything without a hero behind it must be pushed clear
   of it — otherwise the first section renders underneath the bar. */
main{padding-top:var(--nav-h)}
.page--hero main{padding-top:0}

/* The bar carries its own background by default. Only a hero earns the
   transparent, inverted treatment, and only until the page starts scrolling. */
.nav::after{opacity:1}
.page--hero .nav::after{opacity:0}
.page--hero .nav--solid::after{opacity:1}

.page--hero .nav:not(.nav--solid) .nav__toggle{color:#fff}
.page--hero .nav:not(.nav--solid) .nav__phone{color:#fff;border-color:rgba(255,255,255,.75)}
.page--hero .nav:not(.nav--solid) .nav__phone:hover{background:#fff;color:var(--teal)}
.page--hero .nav:not(.nav--solid) .nav__brand img{filter:brightness(0) invert(1)}

/* ---------- full-screen menu ---------- */
.menu{
  position:fixed;inset:0;z-index:80;background:var(--teal);color:#fff;
  display:flex;flex-direction:column;
  clip-path:inset(0 0 100% 0);
  transition:clip-path .7s var(--swift);
  pointer-events:none;
}
.menu-open .menu{clip-path:inset(0 0 0 0);pointer-events:auto}
.menu__top{display:flex;align-items:center;justify-content:space-between;height:var(--nav-h);flex:none}
.menu__logo{height:clamp(1.7rem,3.1vw,2.3rem);width:auto}
.menu__close{background:none;border:0;color:#fff;font-size:2.4rem;line-height:1;
  cursor:pointer;padding:.2rem .4rem;transition:color .25s,transform .35s var(--ease)}
.menu__close:hover{color:var(--coral);transform:rotate(90deg)}
.menu__nav{flex:1;display:flex;flex-direction:column;justify-content:center;gap:.1rem}
.menu__nav a{
  display:flex;align-items:center;gap:1rem;color:rgba(255,255,255,.42);
  font-family:var(--display);font-weight:700;text-transform:uppercase;
  font-size:clamp(1.8rem,6.4vw,4.6rem);line-height:1.08;letter-spacing:-.03em;
  transition:color .3s var(--ease);
}
.menu__nav a:hover,.menu__nav a:focus-visible,.menu__nav a[aria-current]{color:var(--coral)}
.menu__line{display:block;overflow:hidden}
.menu__line>span{display:block;transform:translateY(105%);
  transition:transform .75s var(--swift);transition-delay:calc(var(--i) * 60ms)}
.menu-open .menu__line>span{transform:none}
.menu__nav svg{width:clamp(1.6rem,4vw,3rem);height:auto;flex:none;
  opacity:0;transform:translateX(-14px);
  transition:opacity .3s var(--ease),transform .4s var(--ease)}
.menu__nav a:hover svg,.menu__nav a:focus-visible svg{opacity:1;transform:none}
.menu__foot{flex:none;padding-bottom:clamp(1.4rem,4vw,2.6rem);
  display:flex;flex-wrap:wrap;gap:.6rem 2.4rem;align-items:baseline;
  border-top:1px solid rgba(255,255,255,.18);padding-top:1.4rem}
.menu__phone{font-family:var(--display);font-weight:700;color:var(--coral);
  font-size:clamp(1.15rem,2.6vw,1.9rem);letter-spacing:-.01em}
.menu__phone:hover{color:var(--coral-2)}
.menu__foot p{margin:0;font-size:.86rem;color:rgba(255,255,255,.62)}

/* ---------- buttons ---------- */
.btn{
  display:inline-flex;align-items:center;gap:.6rem;padding:.95rem 1.7rem;
  font-family:var(--display);font-weight:600;font-size:.82rem;
  text-transform:uppercase;letter-spacing:.11em;border:2px solid transparent;
  transition:background .25s,color .25s,border-color .25s,transform .35s var(--ease);
}
.btn:hover{transform:translateY(-2px)}
.btn--coral{background:var(--coral);color:var(--teal);border-color:var(--coral)}
.btn--coral:hover{background:var(--coral-2);border-color:var(--coral-2)}
.btn--teal{background:var(--teal);color:var(--paper);border-color:var(--teal)}
.btn--teal:hover{background:var(--teal-2);border-color:var(--teal-2)}
.btn--ghost{border-color:currentColor}
.btn--ghost:hover{background:var(--teal);color:var(--paper);border-color:var(--teal)}
.block .btn--ghost:hover{background:var(--coral);color:var(--teal);border-color:var(--coral)}

/* ---------- hero ---------- */
.hero{position:relative;min-height:100svh;display:flex;align-items:center;
  background:var(--teal-3);color:#fff;overflow:hidden;isolation:isolate}
.hero__media{position:absolute;inset:0;z-index:-2;will-change:transform}
.hero__media img{width:100%;height:100%;object-fit:cover}
.hero__media::after{content:"";position:absolute;inset:0;
  background:linear-gradient(180deg,rgba(6,30,38,.62) 0%,rgba(6,30,38,.26) 42%,rgba(6,30,38,.78) 100%)}
.hero__in{position:relative;width:100%;padding-block:calc(var(--nav-h) + 2rem) 3rem}
.hero__meta{display:flex;justify-content:space-between;gap:2rem;
  align-items:flex-start;margin-bottom:clamp(1.6rem,5vw,4rem)}
.hero__kick{font-family:var(--display);font-size:.7rem;font-weight:600;
  text-transform:uppercase;letter-spacing:.18em;color:var(--coral);max-width:26rem;line-height:1.7}
.hero__say{font-size:.82rem;color:rgba(255,255,255,.88);max-width:22rem;
  text-align:right;line-height:1.55}
@media(max-width:46rem){
  .hero__meta{flex-direction:column;gap:.9rem}
  .hero__say{text-align:left}
  /* A phone cannot hold the headline on one line, and clipping it mid-word
     reads as a fault rather than a deliberate bleed — so let it wrap. */
  .hero__row{white-space:normal}
  .hero__row--r{text-align:left}
}
/* The headline deliberately overflows the gutters; the halves diverge on scroll. */
.hero__h{margin:0;color:#fff}
.hero__row{display:block;white-space:nowrap;will-change:transform}
.hero__row--r{text-align:right}
/* Must come after the rules above: an earlier media query loses to them on
   source order, which clipped a long headline mid-word on phones. */
@media(max-width:46rem){.hero__row{white-space:normal}.hero__row--r{text-align:left}}
.hero__cta{display:flex;flex-wrap:wrap;gap:.8rem;margin-top:clamp(1.8rem,4vw,3rem)}
.hero__facts{display:flex;flex-wrap:wrap;gap:1.6rem 2.8rem;margin-top:clamp(1.8rem,4vw,3rem);
  padding-top:1.6rem;border-top:1px solid rgba(255,255,255,.24)}
.hero__fact b{display:block;font-family:var(--display);font-size:clamp(1.4rem,2.6vw,2.2rem);
  font-weight:700;color:var(--coral);line-height:1}
.hero__fact span{display:block;margin-top:.35rem;font-size:.7rem;text-transform:uppercase;
  letter-spacing:.14em;color:rgba(255,255,255,.72)}
.hero__scroll{position:absolute;left:50%;bottom:1.4rem;translate:-50% 0;
  font-size:.64rem;letter-spacing:.24em;text-transform:uppercase;
  color:rgba(255,255,255,.6);animation:bob 2.4s ease-in-out infinite}
@keyframes bob{0%,100%{transform:translateY(0)}50%{transform:translateY(6px)}}

/* ---------- mask reveal ---------- */
.mask{display:block;overflow:hidden}
.js .mask>span{display:block;transform:translateY(102%);
  transition:transform .95s var(--swift)}
.js .rv.in .mask>span,.js .mask.in>span{transform:none}
.js .mask:nth-child(2)>span{transition-delay:.08s}
.js .mask:nth-child(3)>span{transition-delay:.16s}

/* ---------- trust strip ---------- */
.strip{padding-block:2.6rem;border-bottom:1px solid var(--rule)}
.strip__t{text-align:center;font-size:.72rem;text-transform:uppercase;
  letter-spacing:.2em;color:var(--muted);margin-bottom:1.6rem}
.strip__row{display:flex;flex-wrap:wrap;justify-content:center;gap:1rem 2.6rem}
.strip__row span{font-family:var(--display);font-weight:600;font-size:.95rem;
  text-transform:uppercase;letter-spacing:.04em;color:var(--muted);
  opacity:.75;transition:opacity .25s,color .25s}
.strip__row a:hover span{opacity:1;color:var(--teal)}

/* ---------- split heading ---------- */
.split{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,1fr);
  gap:clamp(1.8rem,5vw,5rem);align-items:start}
@media(max-width:60rem){.split{grid-template-columns:minmax(0,1fr);gap:2rem}}

/* ---------- segment cards ---------- */
.seg{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1px;background:var(--rule);
  margin-top:3rem;border:1px solid var(--rule)}
@media(max-width:64rem){.seg{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:34rem){.seg{grid-template-columns:minmax(0,1fr)}}
.seg__c{background:var(--paper);padding:2rem 1.6rem 1.8rem;transition:background .3s var(--ease)}
.seg__c:hover{background:var(--paper-2)}
.seg__c h3{font-size:1.15rem;color:var(--teal);margin-bottom:.9rem}
.seg__c p{margin:0;font-size:.95rem;color:var(--ink-2)}
.seg__c a{display:inline-block;margin-top:1.2rem;font-family:var(--display);
  font-size:.74rem;font-weight:600;text-transform:uppercase;letter-spacing:.12em;color:var(--coral-3)}
.seg__c a:hover{color:var(--teal)}

/* ---------- property cards ---------- */
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(19rem,1fr));
  gap:1.6rem;margin-top:2.8rem}
.pc{display:flex;flex-direction:column;background:var(--paper);
  border:1px solid var(--rule);transition:border-color .3s,transform .45s var(--ease),box-shadow .45s var(--ease)}
.pc:hover{border-color:var(--teal);transform:translateY(-4px);
  box-shadow:0 22px 48px -30px rgba(8,40,50,.55)}
.js .grid .pc{opacity:0;transform:translateY(26px);
  transition:opacity .7s var(--swift),transform .7s var(--swift),border-color .3s,box-shadow .45s}
.js .grid.in .pc{opacity:1;transform:none}
.js .grid.in .pc:nth-child(3n+2){transition-delay:.07s}
.js .grid.in .pc:nth-child(3n+3){transition-delay:.14s}
.pc__art{position:relative;aspect-ratio:4/3;overflow:hidden;background:var(--teal-3)}
.pc__art img,.pc__art svg{width:100%;height:100%;object-fit:cover}
.pc__art img{transition:transform .8s var(--ease)}
.pc:hover .pc__art img{transform:scale(1.06)}
.pc__tag{position:absolute;top:0;left:0;background:var(--teal);color:var(--paper);
  font-family:var(--display);font-size:.65rem;font-weight:600;text-transform:uppercase;
  letter-spacing:.12em;padding:.42rem .8rem}
.pc__tag--rent{background:var(--coral);color:var(--teal)}
.pc__tag--business{background:var(--ink)}
.pc__b{padding:1.15rem 1.15rem 1.3rem;display:flex;flex-direction:column;flex:1}
.pc__where{font-size:.7rem;text-transform:uppercase;letter-spacing:.13em;color:var(--muted)}
.pc__t{font-family:var(--display);font-weight:600;font-size:1rem;line-height:1.26;
  text-transform:none;letter-spacing:-.01em;margin:.5rem 0 .75rem;color:var(--teal)}
.pc__price{font-family:var(--display);font-weight:700;font-size:1.22rem;color:var(--teal);margin-top:auto}
.pc__meta{display:flex;flex-wrap:wrap;gap:.9rem;margin-top:.7rem;padding-top:.7rem;
  border-top:1px solid var(--rule);font-size:.8rem;color:var(--ink-2);list-style:none;padding-inline:0}
.pc__meta b{font-weight:500;color:var(--teal)}
.pc__stamp{font-size:.68rem;color:var(--muted);margin-top:.55rem}

/* ---------- rules (light, three columns) ---------- */
.rules{background:var(--paper-2)}
.rules__list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));
  gap:2.4rem 2.8rem;margin-top:clamp(2.4rem,5vw,4rem)}
@media(max-width:64rem){.rules__list{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:40rem){.rules__list{grid-template-columns:minmax(0,1fr);gap:1.8rem}}
.rules__i{border-top:2px solid var(--teal);padding-top:1rem}
.rules__n{font-family:var(--display);font-size:.66rem;font-weight:700;
  letter-spacing:.16em;color:var(--coral-3);display:block;margin-bottom:.6rem}
.rules__i b{display:block;font-family:var(--display);font-weight:700;font-size:1.02rem;
  line-height:1.24;letter-spacing:-.01em;margin-bottom:.5rem;color:var(--teal);text-transform:none}
.rules__i p{margin:0;font-size:.9rem;color:var(--ink-2);font-weight:300}

/* ---------- full-bleed image band ---------- */
.band{position:relative;height:clamp(18rem,44vw,32rem);overflow:hidden;background:var(--teal-3)}
.band img{width:100%;height:100%;object-fit:cover}

/* ---------- stats ---------- */
.stats{width:100%;border-collapse:collapse;margin-top:1.8rem;font-size:.92rem}
.stats th,.stats td{text-align:left;padding:.72rem .4rem;border-bottom:1px solid var(--rule)}
.stats th{font-family:var(--display);font-size:.7rem;font-weight:600;text-transform:uppercase;
  letter-spacing:.11em;color:var(--muted)}
.stats td{color:var(--ink-2)}
.stats td b{color:var(--teal);font-weight:600}

.facts{display:grid;grid-template-columns:repeat(auto-fit,minmax(10rem,1fr));
  gap:1px;background:var(--rule);border:1px solid var(--rule);margin-top:2.4rem}
.facts__i{background:var(--paper);padding:1.5rem 1.3rem}
.facts__i b{display:block;font-family:var(--display);font-weight:700;
  font-size:clamp(1.4rem,2.3vw,1.95rem);color:var(--teal);line-height:1}
.facts__i span{display:block;margin-top:.45rem;font-size:.72rem;text-transform:uppercase;
  letter-spacing:.12em;color:var(--muted)}

/* ---------- chips / crumbs / pager ---------- */
.chips{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:1.6rem}
.chip{display:inline-flex;align-items:center;padding:.5rem 1rem;border:1px solid var(--rule);
  background:var(--paper);font-size:.8rem;transition:all .25s var(--ease)}
.chip:hover{border-color:var(--teal);color:var(--teal);transform:translateY(-2px)}
.crumbs{font-size:.76rem;color:var(--muted);padding-block:1.1rem;
  text-transform:uppercase;letter-spacing:.1em}
.crumbs a:hover{color:var(--teal)}
.crumbs span{margin-inline:.5rem;opacity:.5}
.pager{display:flex;flex-wrap:wrap;gap:.4rem;margin-top:3rem;align-items:center}
.pager a,.pager strong{display:inline-flex;align-items:center;justify-content:center;
  min-width:2.6rem;height:2.6rem;padding-inline:.7rem;border:1px solid var(--rule);
  font-size:.85rem;font-weight:400}
.pager strong{background:var(--teal);color:var(--paper);border-color:var(--teal)}
.pager a:hover{border-color:var(--teal);color:var(--teal)}
.pager__gap{color:var(--muted);padding-inline:.3rem}

/* ---------- detail ---------- */
.dgrid{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(0,1fr);
  gap:clamp(1.8rem,4vw,3.4rem);margin-top:2.2rem}
@media(max-width:62rem){.dgrid{grid-template-columns:minmax(0,1fr)}}
.dhero{aspect-ratio:16/10;overflow:hidden;background:var(--teal-3);border:1px solid var(--rule)}
.dhero img,.dhero svg{width:100%;height:100%;object-fit:cover}
.dthumbs{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:.5rem;margin-top:.5rem}
@media(max-width:34rem){.dthumbs{grid-template-columns:repeat(4,minmax(0,1fr))}}
.dthumbs img{aspect-ratio:4/3;object-fit:cover;border:1px solid var(--rule);
  cursor:pointer;transition:border-color .25s,opacity .25s,transform .3s var(--ease)}
.dthumbs img:hover{border-color:var(--teal);opacity:.85;transform:translateY(-2px)}
.aside{border:1px solid var(--rule);padding:1.6rem;position:sticky;top:calc(var(--nav-h) + 1rem);
  align-self:start;background:var(--paper-2)}
.aside__price{font-family:var(--display);font-weight:700;
  font-size:clamp(1.7rem,3vw,2.3rem);color:var(--teal);line-height:1}
.aside__ref{font-size:.72rem;text-transform:uppercase;letter-spacing:.12em;
  color:var(--muted);margin-top:.6rem}
.aside .btn{width:100%;justify-content:center;margin-top:1.3rem}
.note{font-size:.78rem;color:var(--muted);margin-top:1rem;line-height:1.5}

/* ---------- form ---------- */
.form{display:grid;gap:1rem;margin-top:2rem}
.form__row{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:1rem}
@media(max-width:44rem){.form__row{grid-template-columns:minmax(0,1fr)}}
.form label{display:block;font-size:.72rem;text-transform:uppercase;
  letter-spacing:.12em;margin-bottom:.5rem;opacity:.8}
.form input,.form select,.form textarea{
  width:100%;padding:.85rem 1rem;background:transparent;
  border:1px solid rgba(255,255,255,.34);color:var(--paper);font-size:.95rem;
  transition:border-color .25s}
.form input:focus,.form select:focus,.form textarea:focus{border-color:var(--coral)}
.form textarea{min-height:7rem;resize:vertical}
.form input::placeholder,.form textarea::placeholder{color:rgba(255,255,255,.45)}
.form select option{background:var(--teal);color:var(--paper)}
.form__checks{display:flex;flex-wrap:wrap;gap:.6rem}
.form__checks label{display:inline-flex;align-items:center;gap:.5rem;
  padding:.55rem 1rem;border:1px solid rgba(255,255,255,.34);margin:0;
  letter-spacing:.08em;cursor:pointer;transition:background .25s}
.form__checks label:hover{background:rgba(255,255,255,.08)}

/* ---------- footer ---------- */
.foot{background:var(--teal-3);color:#A9C3C8;padding-block:clamp(3rem,6vw,5rem) 2.2rem}
.foot__logo{height:clamp(3rem,6vw,4.6rem);width:auto;margin-bottom:2.4rem}
.foot__cta{display:block;font-family:var(--display);font-weight:700;
  font-size:clamp(1.6rem,6.4vw,4.4rem);text-transform:uppercase;letter-spacing:-.03em;
  color:var(--coral);line-height:1;transition:color .3s;overflow-wrap:break-word}
.foot__cta:hover{color:var(--coral-2)}
.foot__grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(12rem,1fr));
  gap:2.2rem;margin-top:3.4rem;padding-top:2.4rem;border-top:1px solid rgba(255,255,255,.16)}
.foot h4{font-size:.68rem;font-weight:600;letter-spacing:.16em;color:var(--coral);margin-bottom:1rem}
.foot ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:.55rem;font-size:.88rem}
.foot a:hover{color:var(--coral)}
.foot__legal{margin-top:2.6rem;padding-top:1.6rem;border-top:1px solid rgba(255,255,255,.12);
  font-size:.76rem;display:flex;flex-wrap:wrap;gap:.8rem;justify-content:space-between;color:#7E9AA0}

/* ---------- sticky mobile call bar ---------- */
.callbar{display:none}
@media(max-width:62rem){
  .callbar{display:flex;position:fixed;left:0;right:0;bottom:0;z-index:70;
    background:var(--coral);color:var(--teal);align-items:center;justify-content:center;
    gap:.6rem;padding:.95rem 1rem;font-family:var(--display);font-weight:700;
    font-size:.9rem;text-transform:uppercase;letter-spacing:.1em;
    box-shadow:0 -6px 24px rgba(8,40,50,.22)}
  body{padding-bottom:3.6rem}
  .menu-open .callbar{display:none}
}

/* ---------- reveal ---------- */
.js .rv{opacity:0;transform:translateY(24px);
  transition:opacity .8s var(--swift),transform .8s var(--swift)}
.js .rv.in{opacity:1;transform:none}
.rv-1{transition-delay:.07s}.rv-2{transition-delay:.14s}
.rv-3{transition-delay:.21s}.rv-4{transition-delay:.28s}

@media(prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  *,*::before,*::after{animation-duration:.01ms!important;transition-duration:.01ms!important}
  .js .rv,.js .grid .pc{opacity:1;transform:none}
  .js .mask>span,.menu__line>span{transform:none}
  .menu{transition:none}
}

.sr{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;
  clip:rect(0,0,0,0);white-space:nowrap;border:0}
.skip{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);
  background:var(--teal);color:var(--paper);z-index:100}
.skip:focus{position:fixed;top:0;left:0;width:auto;height:auto;clip:auto;padding:.8rem 1.3rem}

/* ======================================================================
   Move In Thailand additions: long-form guides, the journey, tools.
   Headings inside guides drop the display caps: a 12-word question in
   uppercase is hard to read, and guides are read, not glanced at.
   ====================================================================== */

.wordmark{display:inline-flex;align-items:center;gap:.6rem;color:var(--teal);
  font-family:var(--display);font-weight:800;text-transform:uppercase;
  letter-spacing:-.02em;font-size:clamp(1rem,1.7vw,1.22rem);line-height:1}
.wordmark svg{width:clamp(1.7rem,2.6vw,2.1rem);height:auto;flex:none}
.wordmark small{display:block;font-size:.58em;letter-spacing:.18em;font-weight:600;color:var(--coral-3);margin-top:.28rem}
.page--hero .nav:not(.nav--solid) .wordmark{color:#fff}
.page--hero .nav:not(.nav--solid) .wordmark small{color:var(--coral-2)}
.menu .wordmark,.foot .wordmark{color:#fff}
.menu .wordmark small,.foot .wordmark small{color:var(--coral-2)}

/* page head for guides and hubs */
.phead{padding-block:clamp(2.4rem,6vw,4.6rem) clamp(2rem,4vw,3rem);background:var(--paper-2);
  border-bottom:1px solid var(--rule)}
.phead h1{font-size:clamp(2.1rem,5.4vw,4.6rem);color:var(--teal);max-width:18ch}
.phead .lead{margin-top:1.4rem;max-width:60ch}
.phead__meta{display:flex;flex-wrap:wrap;gap:.5rem 1.4rem;margin-top:1.6rem;font-size:.78rem;color:var(--muted)}
.badge{display:inline-flex;align-items:center;gap:.45rem;padding:.35rem .75rem;border:1px solid var(--rule);
  background:var(--paper);font-size:.72rem;text-transform:uppercase;letter-spacing:.1em;color:var(--teal)}
.badge i{width:.5rem;height:.5rem;border-radius:50%;background:#2E9E6B;display:block}

/* guide layout: article + sticky side */
.guide{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,19rem);gap:clamp(2rem,5vw,4.5rem);
  padding-block:clamp(2.4rem,5vw,4rem)}
@media(max-width:64rem){.guide{grid-template-columns:minmax(0,1fr)}}
.side{position:sticky;top:calc(var(--nav-h) + 1rem);align-self:start;display:grid;gap:1.2rem}
@media(max-width:64rem){.side{position:static}}
.toc{border:1px solid var(--rule);padding:1.3rem 1.3rem 1.1rem;background:var(--paper)}
.toc b{display:block;font-family:var(--display);font-size:.7rem;letter-spacing:.16em;text-transform:uppercase;color:var(--muted);margin-bottom:.8rem}
.toc ol{margin:0;padding-left:1.1rem;display:grid;gap:.45rem;font-size:.9rem}
.toc a:hover{color:var(--coral-3)}
.ask{background:var(--teal);color:#fff;padding:1.5rem}
.ask b{display:block;font-family:var(--display);font-weight:700;font-size:1.15rem;line-height:1.2;text-transform:uppercase;letter-spacing:-.01em}
.ask p{margin:.7rem 0 1.1rem;font-size:.9rem;color:#CFE2E5}
.ask .btn{width:100%;justify-content:center}
.ask .btn+.btn{margin-top:.6rem}

/* prose */
.prose{font-size:1.04rem;max-width:72ch}
.prose>section{scroll-margin-top:calc(var(--nav-h) + 1rem)}
.prose>section+section{margin-top:clamp(2.4rem,4vw,3.4rem)}
.prose h2{font-size:clamp(1.45rem,2.6vw,2.05rem);text-transform:none;letter-spacing:-.025em;line-height:1.12;color:var(--teal);margin-bottom:1rem}
.prose h3{font-size:1.15rem;text-transform:none;letter-spacing:-.01em;line-height:1.25;color:var(--teal);margin:1.6rem 0 .6rem}
.prose p{margin:0 0 1rem;color:var(--ink-2)}
.prose a{color:var(--teal);text-decoration:underline;text-decoration-color:var(--coral);text-underline-offset:3px;text-decoration-thickness:2px}
.prose a:hover{color:var(--coral-3)}
.prose strong{font-weight:600;color:var(--ink)}
.prose ul,.prose ol{margin:0 0 1.1rem;padding-left:1.25rem;display:grid;gap:.45rem;color:var(--ink-2)}
.prose li::marker{color:var(--coral-3);font-weight:600}
.steps{list-style:none;padding:0!important;counter-reset:s;gap:0!important;border-left:2px solid var(--rule);margin-left:.9rem!important}
.steps li{counter-increment:s;position:relative;padding:0 0 1.3rem 2rem}
.steps li::before{content:counter(s);position:absolute;left:-1.05rem;top:-.1rem;width:2rem;height:2rem;
  display:grid;place-items:center;background:var(--teal);color:#fff;font-family:var(--display);font-weight:700;font-size:.85rem;border-radius:50%}
.callout{border-left:4px solid var(--coral);background:var(--paper-2);padding:1.1rem 1.3rem;margin:1.2rem 0;color:var(--ink)}
.callout--warn{border-color:#C9452E;background:#FBF0EC}
.tbl{width:100%;overflow-x:auto;margin:1rem 0 1.4rem;border:1px solid var(--rule)}
.tbl table{width:100%;border-collapse:collapse;font-size:.92rem}
.tbl--stack table{min-width:30rem}
.tbl th,.tbl td{padding:.75rem .9rem;text-align:left;vertical-align:top;border-bottom:1px solid var(--rule)}
.tbl th{background:var(--paper-2);font-family:var(--display);font-size:.7rem;font-weight:600;text-transform:uppercase;letter-spacing:.1em;color:var(--teal)}
.tbl tr:last-child td{border-bottom:0}
.tbl td:first-child{font-weight:500;color:var(--ink)}

/* key facts row on guides */
.kfacts{display:grid;grid-template-columns:repeat(auto-fit,minmax(9.5rem,1fr));gap:1px;background:var(--rule);border:1px solid var(--rule);margin:0 0 2.4rem}
.kfacts div{background:var(--paper);padding:1.1rem 1rem}
.kfacts b{display:block;font-family:var(--display);font-weight:700;font-size:clamp(1.15rem,2vw,1.5rem);line-height:1.05;color:var(--teal)}
.kfacts span{display:block;margin-top:.4rem;font-size:.7rem;text-transform:uppercase;letter-spacing:.1em;color:var(--muted)}

/* FAQ */
.faq{border-top:1px solid var(--rule)}
.faq details{border-bottom:1px solid var(--rule)}
.faq summary{list-style:none;cursor:pointer;display:flex;justify-content:space-between;gap:1rem;align-items:center;
  padding:1.1rem 0;font-weight:500;color:var(--ink)}
.faq summary::-webkit-details-marker{display:none}
.faq summary::after{content:"+";font-family:var(--display);font-size:1.5rem;line-height:1;color:var(--coral-3);transition:transform .3s var(--ease)}
.faq details[open] summary::after{transform:rotate(45deg)}
.faq details>div{padding:0 0 1.2rem;color:var(--ink-2)}
.faq details>div p{margin:0}

.sources{font-size:.86rem;color:var(--muted)}
.sources ul{margin:.4rem 0 0;padding-left:1.1rem}

/* next step in the journey */
.next{display:flex;justify-content:space-between;align-items:center;gap:1.4rem;flex-wrap:wrap;
  margin-top:clamp(2.6rem,5vw,3.6rem);padding:1.6rem 1.7rem;background:var(--teal);color:#fff;transition:background .3s}
.next:hover{background:var(--teal-2)}
.next span{font-size:.72rem;text-transform:uppercase;letter-spacing:.16em;color:var(--coral-2)}
.next b{display:block;font-family:var(--display);font-weight:700;font-size:clamp(1.15rem,2.2vw,1.6rem);line-height:1.1;margin-top:.35rem;text-transform:uppercase;letter-spacing:-.02em}
.next svg{width:2.4rem;flex:none;transition:transform .35s var(--ease)}
.next:hover svg{transform:translateX(6px)}

/* cards for hubs and related guides */
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(17rem,1fr));gap:1px;background:var(--rule);border:1px solid var(--rule);margin-top:2.4rem}
.card{background:var(--paper);padding:1.7rem 1.5rem 1.5rem;display:flex;flex-direction:column;gap:.7rem;transition:background .3s var(--ease)}
.card:hover{background:var(--paper-2)}
.card small{font-size:.68rem;text-transform:uppercase;letter-spacing:.14em;color:var(--coral-3);font-weight:500}
.card h3{font-size:1.12rem;text-transform:none;letter-spacing:-.015em;line-height:1.2;color:var(--teal)}
.card p{margin:0;font-size:.93rem;color:var(--ink-2)}
.card i{margin-top:auto;padding-top:.6rem;font-style:normal;font-family:var(--display);font-size:.72rem;font-weight:600;text-transform:uppercase;letter-spacing:.12em;color:var(--teal)}
.card:hover i{color:var(--coral-3)}

/* the five-step journey on the home page */
.journey{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:1px;background:rgba(255,255,255,.16);margin-top:clamp(2.4rem,5vw,3.6rem);border:1px solid rgba(255,255,255,.16)}
@media(max-width:70rem){.journey{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:36rem){.journey{grid-template-columns:minmax(0,1fr)}}
.journey a{background:var(--teal);padding:1.8rem 1.4rem 1.6rem;display:flex;flex-direction:column;gap:.7rem;transition:background .3s var(--ease)}
.journey a:hover{background:var(--teal-2)}
.journey em{font-style:normal;font-family:var(--display);font-weight:800;font-size:2.6rem;line-height:.9;color:var(--coral)}
.journey b{font-family:var(--display);font-weight:700;font-size:1.05rem;text-transform:uppercase;letter-spacing:-.01em;line-height:1.15}
.journey p{margin:0;font-size:.9rem;color:#CFE2E5}
.journey i{margin-top:auto;font-style:normal;font-size:.72rem;text-transform:uppercase;letter-spacing:.14em;color:var(--coral-2)}

/* tools */
.tool{border:1px solid var(--rule);background:var(--paper);padding:clamp(1.4rem,3vw,2.2rem);margin-top:2rem}
.q{border:0;margin:0 0 1.6rem;padding:0}
.q legend{font-family:var(--display);font-weight:700;font-size:1.05rem;color:var(--teal);margin-bottom:.8rem;text-transform:none;letter-spacing:-.01em}
.opts{display:flex;flex-wrap:wrap;gap:.5rem}
.opts label{display:inline-flex;align-items:center;gap:.5rem;padding:.65rem 1rem;border:1px solid var(--rule);cursor:pointer;font-size:.92rem;transition:border-color .2s,background .2s}
.opts label:hover{border-color:var(--teal)}
.opts input{accent-color:var(--teal)}
.opts label:has(input:checked){border-color:var(--teal);background:var(--paper-2)}
.result{margin-top:1.4rem;padding:1.4rem 1.5rem;background:var(--teal);color:#fff}
.result[hidden]{display:none}
.result h3{text-transform:none;letter-spacing:-.01em;font-size:1.3rem;margin-bottom:.6rem}
.result ul{margin:.6rem 0 1rem;padding-left:1.2rem;display:grid;gap:.4rem;color:#DDEBED}
.result a:not(.btn){color:#fff;text-decoration:underline;text-decoration-color:var(--coral)}
.field{display:grid;gap:.4rem;margin-bottom:1.1rem}
.field label{font-size:.78rem;text-transform:uppercase;letter-spacing:.1em;color:var(--muted)}
.field select,.field input{padding:.75rem .9rem;border:1px solid var(--rule);background:var(--paper);font-size:.95rem}
.total{font-family:var(--display);font-weight:800;font-size:clamp(2rem,5vw,3.4rem);color:var(--teal);line-height:1}

/* light contact form on the paper ground */
.lform{display:grid;gap:1rem}
.lform label{display:block;font-size:.74rem;text-transform:uppercase;letter-spacing:.1em;margin-bottom:.4rem;color:var(--muted)}
.lform input,.lform select,.lform textarea{width:100%;padding:.85rem 1rem;border:1px solid var(--rule);background:var(--paper);font-size:.95rem}
.lform input:focus,.lform select:focus,.lform textarea:focus{border-color:var(--teal);outline:none}
.lform textarea{min-height:7rem;resize:vertical}

.trust{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:2rem;margin-top:clamp(2.2rem,4vw,3.2rem)}
@media(max-width:60rem){.trust{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:34rem){.trust{grid-template-columns:minmax(0,1fr)}}
.trust div{border-top:2px solid var(--coral);padding-top:1rem}
.trust b{display:block;font-family:var(--display);font-weight:700;font-size:1.05rem;color:var(--teal);text-transform:uppercase;letter-spacing:-.01em;margin-bottom:.45rem}
.trust p{margin:0;font-size:.92rem;color:var(--ink-2)}

/* Phones: a table of three or more columns becomes one labelled card per row,
   because sideways-scrolling a requirements table is how details get missed. */
@media(max-width:40rem){
  .tbl--stack{border:0;overflow:visible}
  .tbl--stack table{min-width:0}
  .tbl--stack thead{display:none}
  .tbl--stack tr{display:block;border:1px solid var(--rule);margin-bottom:.8rem;background:var(--paper)}
  .tbl--stack td{display:grid;grid-template-columns:minmax(0,7rem) minmax(0,1fr);gap:.8rem;padding:.6rem .8rem}
  .tbl--stack td::before{content:attr(data-label);font-family:var(--display);font-size:.64rem;font-weight:600;
    text-transform:uppercase;letter-spacing:.08em;color:var(--muted);padding-top:.15rem}
  .tbl--stack td:first-child{display:block;background:var(--paper-2);font-weight:600}
  .tbl--stack td:first-child::before{content:none}
  .tbl--stack tr:last-child td{border-bottom:1px solid var(--rule)}
  .tbl--stack td:last-child{border-bottom:0}
}
