{%- macro wordmark(brand) -%}
<span class="wordmark"><svg viewBox="0 0 32 40" aria-hidden="true"><path d="M16 2C8.3 2 2 8.2 2 15.9 2 26.4 16 38 16 38s14-11.6 14-22.1C30 8.2 23.7 2 16 2z" fill="none" stroke="currentColor" stroke-width="3"/><path d="M10.5 26V16.5a5.5 5.5 0 0 1 11 0V26z" fill="#EE7B61"/><circle cx="19" cy="21.5" r="1.3" fill="currentColor"/></svg><span>Move In Thailand<small>Visa · Home · Business</small></span></span>
{%- endmacro -%}

{%- macro arrow() -%}
<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2"/></svg>
{%- endmacro -%}

{%- macro wa(brand, text) -%}
https://wa.me/{{ brand.whatsapp }}?text={{ text|urlencode }}
{%- endmacro -%}

{%- macro card(p, label='') -%}
<a class="card" href="{{ p.path }}">
  {%- if label or p.kicker %}<small>{{ label or p.kicker }}</small>{% endif %}
  <h3>{{ p.short or (p.h1|plain) }}</h3>
  <p>{{ p.card or (p.description|plain) }}</p>
  <i>Read the guide &rarr;</i>
</a>
{%- endmacro -%}

{%- macro crumbs_nav(crumbs, page) -%}
{%- if crumbs %}
<nav class="crumbs wrap" aria-label="Breadcrumb">
  {%- for name, href in crumbs %}<a href="{{ href }}">{{ name }}</a><span>/</span>{% endfor %}{{ page.short or (page.h1|plain) }}
</nav>
{%- endif %}
{%- endmacro -%}

{%- macro section_body(s) -%}
{%- for para in s.p or [] %}<p>{{ para|md }}</p>{% endfor %}
{%- if s.list %}<ul>{% for i in s.list %}<li>{{ i|md }}</li>{% endfor %}</ul>{% endif %}
{%- if s.steps %}<ol class="steps">{% for i in s.steps %}<li>{{ i|md }}</li>{% endfor %}</ol>{% endif %}
{%- if s.table %}
<div class="tbl{% if s.table.head|length > 2 %} tbl--stack{% endif %}" role="region" aria-label="{{ (s.h2 or 'Table')|plain }}" tabindex="0"><table>
  <thead><tr>{% for h in s.table.head %}<th scope="col">{{ h }}</th>{% endfor %}</tr></thead>
  <tbody>{% for row in s.table.rows %}<tr>{% for c in row %}<td data-label="{{ s.table.head[loop.index0] }}">{{ c|md }}</td>{% endfor %}</tr>{% endfor %}</tbody>
</table></div>
{%- endif %}
{%- for para in s.after or [] %}<p>{{ para|md }}</p>{% endfor %}
{%- if s.note %}<div class="callout">{{ s.note|md }}</div>{% endif %}
{%- if s.warn %}<div class="callout callout--warn">{{ s.warn|md }}</div>{% endif %}
{%- endmacro -%}

{%- macro faq_block(items) -%}
<div class="faq">
  {%- for qa in items %}
  <details{% if loop.first %} open{% endif %}><summary>{{ qa.q }}</summary><div><p>{{ qa.a|md }}</p></div></details>
  {%- endfor %}
</div>
{%- endmacro -%}

{%- macro next_step(nxt) -%}
{%- if nxt %}
<a class="next" href="{{ nxt.path }}"><span>Next step<b>{{ nxt.short or (nxt.h1|plain) }}</b></span>{{ arrow() }}</a>
{%- endif %}
{%- endmacro -%}

{%- macro home_card(h) -%}
<a class="pc" href="{{ h.url }}" rel="noopener">
  <div class="pc__art"><img src="{{ h.image }}" alt="{{ h.title }}" loading="lazy" width="640" height="480"><span class="pc__tag{% if h.deal == 'For rent' %} pc__tag--rent{% endif %}">{{ h.deal }}</span></div>
  <div class="pc__b">
    <span class="pc__where">{{ h.where }}</span>
    <h3 class="pc__t">{{ h.title }}</h3>
    <span class="pc__price">{{ h.price }}</span>
  </div>
</a>
{%- endmacro -%}
