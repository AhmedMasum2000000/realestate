{% extends "base.html.j2" %}
{%- from "macros.html.j2" import faq_block, card, home_card, wa, arrow %}
{% block content %}
{%- set h = page.hero %}
<section class="hero" data-hero>
  <div class="hero__media" data-hero-media><img src="/assets/brand/{{ site.hero_image.split('/')[-1] }}" alt="{{ h.alt }}" width="1600" height="1000" fetchpriority="high"></div>
  <div class="wrap hero__in" data-hero-in>
    <div class="hero__meta">
      <span class="hero__kick">{{ h.kicker }}</span>
      <p class="hero__say">{{ h.say }}</p>
    </div>
    <h1 class="hero__h d1">
      <span class="hero__row" data-hero-l>{{ h.line1 }}</span>
      <span class="hero__row hero__row--r" data-hero-r>{{ h.line2 }}</span>
    </h1>
    <div class="hero__cta">
      <a class="btn btn--coral" href="/tools/visa-finder/">Find my visa in 2 minutes</a>
      <a class="btn btn--ghost" href="/start-here/" style="color:#fff">See the whole move, step by step</a>
    </div>
    <div class="hero__facts">
      {%- for f in h.facts %}<div class="hero__fact"><b>{{ f.v }}</b><span>{{ f.k }}</span></div>{% endfor %}
    </div>
  </div>
  <span class="hero__scroll" aria-hidden="true">Scroll</span>
</section>

<section class="sec">
  <div class="wrap">
    <div class="split">
      <h2 class="d2 rv" style="color:var(--teal)"><span class="mask"><span>What brings you</span></span><span class="mask"><span>to Thailand?</span></span></h2>
      <p class="lead rv rv-1">{{ page.segments_intro }}</p>
    </div>
    <div class="seg rv">
      {%- for s in page.segments %}
      <div class="seg__c"><h3>{{ s.title }}</h3><p>{{ s.text }}</p><a href="{{ s.href }}">{{ s.cta }} &rarr;</a></div>
      {%- endfor %}
    </div>
  </div>
</section>

<section class="sec block">
  <div class="wrap">
    <div class="split">
      <h2 class="d2 rv"><span class="mask"><span>Your move</span></span><span class="mask"><span>in five steps</span></span></h2>
      <p class="lead rv rv-1">{{ page.journey_intro }}</p>
    </div>
    <div class="journey rv">
      {%- for j in site.journey %}
      <a href="{{ j.href }}"><em>0{{ loop.index }}</em><b>{{ j.title }}</b><p>{{ j.text }}</p><i>{{ j.cta }} &rarr;</i></a>
      {%- endfor %}
    </div>
  </div>
</section>

<section class="sec">
  <div class="wrap">
    <span class="kick">The visa routes at a glance</span>
    <h2 class="d2 rv" style="color:var(--teal);max-width:20ch">Eight ways to stay. One will fit you best.</h2>
    <div class="tbl tbl--stack rv" style="margin-top:2.2rem" role="region" aria-label="Visa routes compared" tabindex="0"><table>
      <thead><tr><th scope="col">Route</th><th scope="col">Best for</th><th scope="col">Stay</th><th scope="col">Key requirement</th></tr></thead>
      <tbody>
      {%- for v in page.visa_table %}
      <tr><td data-label="Route"><a href="{{ v.href }}" style="color:var(--teal);font-weight:600">{{ v.name }}</a></td><td data-label="Best for">{{ v.who }}</td><td data-label="Stay">{{ v.stay }}</td><td data-label="Key requirement">{{ v.need }}</td></tr>
      {%- endfor %}
      </tbody>
    </table></div>
    <p style="margin-top:1.4rem;display:flex;gap:.8rem;flex-wrap:wrap">
      <a class="btn btn--teal" href="/tools/visa-finder/">Get my shortlist</a>
      <a class="btn btn--ghost" href="/visas/">Compare every route</a>
    </p>
  </div>
</section>

<section class="sec rules">
  <div class="wrap">
    <span class="kick">Why people choose one desk</span>
    <h2 class="d2 rv" style="color:var(--teal);max-width:22ch">No surprise fees. No shortcuts. No guessing what comes next.</h2>
    <div class="trust">
      {%- for t in page.promises %}<div class="rv"><b>{{ t.title }}</b><p>{{ t.text }}</p></div>{% endfor %}
    </div>
  </div>
</section>

{%- if homes %}
<section class="sec">
  <div class="wrap">
    <div class="split">
      <h2 class="d2 rv" style="color:var(--teal)"><span class="mask"><span>A home that's</span></span><span class="mask"><span>ready when you are</span></span></h2>
      <p class="lead rv rv-1">Rentals and homes for sale across Pattaya, Jomtien and the east, from our partner Pattaya Home Pro. Every listing shows its price; viewings can be booked before you fly.</p>
    </div>
    <div class="grid rv">{% for h in homes %}{{ home_card(h) }}{% endfor %}</div>
    <p style="margin-top:1.6rem;display:flex;gap:.8rem;flex-wrap:wrap"><a class="btn btn--teal" href="/homes/">How renting and buying work</a><a class="btn btn--ghost" href="{{ partner_url }}/properties/" rel="noopener">Browse every listing</a></p>
  </div>
</section>
{%- endif %}

<section class="sec" style="background:var(--paper-2)">
  <div class="wrap">
    <span class="kick">After you land</span>
    <h2 class="d2 rv" style="color:var(--teal);max-width:20ch">The paperwork that keeps you here, made simple</h2>
    <div class="cards">{% for href in page.after_landing %}{{ card(pages[href]) }}{% endfor %}</div>
  </div>
</section>

<section class="sec">
  <div class="wrap" style="max-width:60rem">
    <span class="kick">Straight answers</span>
    <h2 class="d2" style="color:var(--teal)">Before you ask</h2>
    <div class="prose" style="max-width:none;margin-top:1.6rem">{{ faq_block(page.faq) }}</div>
  </div>
</section>

<section class="sec block">
  <div class="wrap">
    <div class="split">
      <h2 class="d2 rv"><span class="mask"><span>You bring the story.</span></span><span class="mask"><span>We bring the plan.</span></span></h2>
      <div class="rv rv-1">
        <p class="lead">A free 15-minute call. You leave with your best visa route, a realistic monthly budget and a written, fixed quote if you want our help.</p>
        <p style="margin-top:1.6rem;display:flex;gap:.8rem;flex-wrap:wrap">
          <a class="btn btn--coral" href="{{ wa(brand, 'Hi, I would like a free 15-minute call about moving to Thailand.') }}" rel="noopener">Book on WhatsApp</a>
          <a class="btn btn--ghost" href="/contact/">Other ways to reach us</a>
        </p>
      </div>
    </div>
  </div>
</section>
{% endblock %}
