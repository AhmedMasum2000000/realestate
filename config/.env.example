# ---------------------------------------------------------------------------
# Copy this file to config/.env and fill it in. NEVER commit config/.env --
# it is already in .gitignore.
#
# Do not paste any of these values into a chat window. They stay on your disk.
#
# Keys here apply to every host. To give one host its own value, append the
# host name from `hosts:` in sites.yml, e.g. SSH_KEY_PATH_HOSTINGER. A
# suffixed key wins for its host; anything unsuffixed is the fallback.
# ---------------------------------------------------------------------------

# --- SSH (this is the important one) ----------------------------------------
# Almost everything runs over SSH + WP-CLI: settings, theme, plugins, logo,
# the listing content type, and the CSV import. A site that already exists
# needs nothing below this section.

# The server address. For cPanel this is usually the same as CPANEL_HOST.
SSH_HOST=
SSH_USER=
SSH_PORT=22

# Point this at your private key file. Key auth is strongly preferred.
# Windows example: C:/Users/Zakaria/.ssh/id_ed25519
SSH_KEY_PATH=

# Only if your host refuses key auth. Leave blank when using a key.
SSH_PASSWORD=

# Your home directory on the server. Usually /home/<username>.
# Left blank, it is guessed from SSH_USER.
SERVER_HOME=


# --- cPanel (only needed to CREATE a domain or database) ---------------------
# Skip this entirely if every site you are working on already exists. Mark
# such a host `kind: ssh` in sites.yml and the toolkit will not ask for these.

# The hostname you log into, without https:// and without :2083
CPANEL_HOST=

# Your cPanel username (NOT your email address)
CPANEL_USER=

# An API TOKEN, not your password.
# cPanel -> Security -> Manage API Tokens -> Create. Copy it once; it is not
# shown again.
CPANEL_API_TOKEN=

CPANEL_PORT=2083


# --- A second host, if your sites are split across two servers ---------------
# The survey found the `hostinger-reach` plugin on secondpassportpro.com and
# mysecondhomepro.com. If those are on Hostinger, define a `hostinger` host in
# sites.yml with `kind: ssh`, set `host: hostinger` on those sites, and fill
# these in. Hostinger has no cPanel API, so no token is needed -- and none of
# the steps those sites need require one.
#
# SSH_HOST_HOSTINGER=
# SSH_USER_HOSTINGER=
# SSH_KEY_PATH_HOSTINGER=
# SERVER_HOME_HOSTINGER=
