# ---------------------------------------------------------------------------
# Copy this file to config/.env and fill it in. NEVER commit config/.env --
# it is already in .gitignore.
#
# Do not paste any of these values into a chat window. They stay on your disk.
# ---------------------------------------------------------------------------

# --- cPanel -----------------------------------------------------------------
# The hostname you log into, without https:// and without :2083
CPANEL_HOST=server123.yourhost.com

# Your cPanel username (NOT your email address)
CPANEL_USER=

# An API TOKEN, not your password.
# Create one at: cPanel -> Security -> Manage API Tokens -> Create
# Give it a name like "provisioning". Copy the token once -- it is not shown again.
CPANEL_API_TOKEN=

# Port is 2083 for cPanel. Only change if your host told you to.
CPANEL_PORT=2083


# --- SSH (needed to install WordPress and run WP-CLI) ------------------------
# Most cPanel plans include SSH. If yours does not, ask your host to enable it.
SSH_HOST=${CPANEL_HOST}
SSH_USER=${CPANEL_USER}
SSH_PORT=22

# Point this at your private key file. Key auth is strongly preferred.
# Windows example: C:/Users/Zakaria/.ssh/id_ed25519
SSH_KEY_PATH=

# Only if your host refuses key auth. Leave blank when using a key.
SSH_PASSWORD=


# --- Where sites live on the server -----------------------------------------
# The absolute path to your home directory on the server.
# Usually /home/<your cPanel username>
SERVER_HOME=/home/${CPANEL_USER}


# --- WHM (optional) ----------------------------------------------------------
# Only needed if each domain should be its OWN cPanel account rather than an
# addon domain under one account. Leave blank for the normal setup.
WHM_HOST=
WHM_USER=
WHM_API_TOKEN=
