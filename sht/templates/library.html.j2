{% extends 'base.html.j2' %}
{% from 'parts.html.j2' import mono, cta, crumbs, button with context %}
{% block content %}
<section class="page-hero">
  <div class="frame">
    {{ crumbs(page) }}
    <div class="page-hero-grid">
      <div>{{ mono('The residency library') }}<h1 class="display page-title" data-reveal-words>Read first. <em>Decide later.</em></h1></div>
      <div class="page-hero-side"><p class="lede">{{ metrics[0][0] }} practical guides for living in Thailand long term, each linked to the official source that decides. Free to read, written to be acted on.</p></div>
    </div>
  </div>
</section>
{% for name, slug in hubs %}{% set guides = guides_in(slug) %}{% if guides %}
<section class="section library-group" aria-labelledby="group-{{ slug }}">
  <div class="frame library-grid">
    <div class="library-head"><span class="index mono">{{ '%02d'|format(loop.index) }}</span><h2 id="group-{{ slug }}" class="display">{{ name }}</h2><span class="mono">{{ guides|length }} {{ 'guide' if guides|length == 1 else 'guides' }}</span></div>
    <ol class="index-list">{% for guide in guides %}<li data-stagger><a href="{{ url(guide.slug ~ '/') }}"><span class="index-title">{{ label(guide) if guide.slug != slug else 'Overview' }}</span><span class="index-desc">{{ guide.description }}</span>{{ icon('arrow') }}</a></li>{% endfor %}</ol>
  </div>
</section>
{% endif %}{% endfor %}
{{ cta(title='Reading is good. <em>A plan is better.</em>') }}
{% endblock %}
