{% from 'parts.html.j2' import mono with context %}<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ page.title }}</title>
  <meta name="description" content="{{ page.description }}">
  <meta name="theme-color" content="#e7e2d8">
  <meta name="robots" content="{{ 'noindex,nofollow' if preview or page.template == '404' else 'index,follow' }}">
  <link rel="canonical" href="{{ canonical }}">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Second Home Thailand">
  <meta property="og:title" content="{{ page.title }}">
  <meta property="og:description" content="{{ page.description }}">
  <meta property="og:url" content="{{ site }}{{ page.slug }}{{ '/' if page.slug else '' }}">
  <meta property="og:image" content="{{ site }}wp-content/sht-site/assets/og.png">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="{{ asset('mark.svg') }}" type="image/svg+xml">
  <link rel="apple-touch-icon" href="{{ asset('mark.png') }}">
  <link rel="preload" href="{{ asset('fonts/anton-latin-400-normal.woff2') }}" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="{{ asset('fonts/inter-latin-400-normal.woff2') }}" as="font" type="font/woff2" crossorigin>
  {% if page.template == 'home' %}<link rel="preload" as="image" href="{{ asset('photos/summit-800.webp') }}" imagesrcset="{{ asset('photos/summit-800.webp') }} 800w, {{ asset('photos/summit-1600.webp') }} 1600w, {{ asset('photos/summit-2000.webp') }} 2000w" imagesizes="100vw" fetchpriority="high">{% endif %}
  <script>(function(d){d.classList.add(window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches?'motion-lite':'motion-ok')})(document.documentElement)</script>
  <link rel="stylesheet" href="{{ asset('site.css') }}">
  {% if schema %}<script type="application/ld+json">{{ schema|tojson }}</script>{% endif %}
</head>
<body data-page="{{ page.template }}">
<a class="skip-link" href="#main">Skip to content</a>
<div class="progress" aria-hidden="true"><span data-page-progress></span></div>
<header class="header">
  <div class="frame header-inner">
    <a class="brand" href="{{ url('') }}" aria-label="Second Home Thailand home">
      <svg class="brand-mark" viewBox="0 0 40 40" aria-hidden="true"><rect x="1" y="1" width="38" height="38" fill="none" stroke="currentColor" stroke-width="2"/><path d="M8 25h24" stroke="#4a90c2" stroke-width="2"/><path d="M8 25a12 12 0 0 1 24 0" fill="none" stroke="currentColor" stroke-width="2"/><path d="M8 31h24" stroke="currentColor" stroke-width="1"/></svg>
      <span class="brand-name">Second Home<small>Thailand · Residency concierge</small></span>
    </a>
    <button class="menu-toggle" aria-expanded="false" aria-controls="navigation" aria-label="Open navigation"><span></span><span></span></button>
    <nav id="navigation" class="navigation" aria-label="Main navigation">
      {% for name, path in [('Concierge','concierge'),('Routes','visas'),('Approach','approach'),('Library','library')] %}<a href="{{ url(path ~ '/') }}"{% if page.slug == path or (path == 'visas' and page.slug.startswith('visas/')) or (path == 'library' and page.shared and not page.slug.startswith('visas')) %} aria-current="page"{% endif %}>{{ name }}</a>{% endfor %}
      <a class="nav-cta" href="{{ url('contact/') }}">Consultation</a>
    </nav>
  </div>
</header>
<main id="main">
<!--sht-content-start-->
{% block content %}{% endblock %}
<!--sht-content-end-->
</main>
<footer class="footer">
  <div class="frame">
    <div class="footer-cta">
      {{ mono('Begin with a conversation') }}
      <a class="footer-big" href="{{ url('contact/') }}"><span>Schedule</span> <span>consultation</span> {{ icon('arrow') }}</a>
    </div>
    <div class="footer-grid">
      <div><p class="footer-lede">A private residency desk for people making Thailand their second home. Route, home, paperwork and arrival, planned once and agreed in writing.</p></div>
      <div>{{ mono('Concierge') }}<a href="{{ url('concierge/') }}">Engagements</a><a href="{{ url('approach/') }}">Our approach</a><a href="{{ url('contact/') }}">Consultation</a><a data-whatsapp hidden href="#">WhatsApp</a></div>
      <div>{{ mono('Routes') }}{% for spec in route_specs %}<a href="{{ url('visas/' ~ spec.slug ~ '/') }}">{{ spec.name }}</a>{% endfor %}<a href="{{ url('tools/visa-finder/') }}">Visa Finder</a></div>
      <div>{{ mono('Library') }}{% for name, slug in hubs[1:] %}<a href="{{ url(slug ~ '/') }}">{{ name }}</a>{% endfor %}</div>
    </div>
    <p class="footer-note">Our guide library is shared with our sister site, <a href="{{ sister }}" rel="noopener">Move In Thailand</a>. Visa and immigration decisions are made by the responsible Thai authorities.</p>
    <div class="footer-wordmark" aria-hidden="true"><span>Second</span><span>Home</span></div>
    <div class="footer-bottom"><span>© {{ '2026' }} Second Home Thailand</span><span data-local-time>Pattaya · ICT</span><a href="{{ url('privacy/') }}">Privacy</a></div>
  </div>
</footer>
<a class="mobile-cta" href="{{ url('contact/') }}">Schedule consultation {{ icon('arrow') }}</a>
<script id="sht-config" type="application/json">{{ config|tojson }}</script>
<script defer src="{{ asset('site.js') }}"></script>
<script defer src="{{ asset('motion.js') }}"></script>
</body>
</html>
