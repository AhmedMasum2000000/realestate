{% extends 'base.html.j2' %}
{% from 'parts.html.j2' import mono, crumbs, hero_photo with context %}
{% block content %}
<section class="page-hero">
  <div class="frame">
    <nav class="crumbs mono" aria-label="Breadcrumb"><a href="{{ url('') }}">Home</a><span>/</span><a href="{{ url('visas/') }}">Routes</a><span>/</span><span aria-current="page">Visa Finder</span></nav>
    <div class="page-hero-grid">
      <div>{{ mono('The Visa Finder') }}<h1 class="display page-title" data-reveal-words>Find your <em>starting point.</em></h1></div>
      <div class="page-hero-side"><p class="lede">Four questions about your plans. A shortlist of routes worth exploring. No account, no contact details, and your answers stay in your browser.</p></div>
    </div>
    {{ hero_photo('temple') }}
  </div>
</section>
<section class="section finder">
  <div class="frame finder-grid">
    <div id="visa-finder" class="quiz">
      <div class="quiz-top mono"><span>Your route to explore</span><span id="quiz-step">01 / 04</span></div>
      <div class="bar" aria-hidden="true"><span id="quiz-progress"></span></div>
      <div id="quiz-content" aria-live="polite"></div>
      <div class="quiz-actions"><button type="button" id="quiz-back" class="text-arrow">← Back</button><button type="button" id="quiz-next" class="button" disabled>Next question {{ icon('arrow') }}</button></div>
    </div>
    <aside class="aside"><div class="aside-card">{{ mono('A clearer first conversation') }}<p>The result is a shortlist to discuss, not an eligibility decision. Nationality, application location and documents still need checking.</p><a class="text-arrow" href="{{ url('visas/') }}">Compare every route {{ icon('arrow') }}</a></div></aside>
  </div>
  <noscript><div class="frame note">The Visa Finder needs JavaScript. You can <a href="{{ url('visas/') }}">compare all routes here</a>.</div></noscript>
</section>
{% endblock %}
