{% from 'boon.html.j2' import boon %}
<aside class="boon-note" id="boon-note" role="dialog" aria-labelledby="boon-note-title" aria-describedby="boon-note-text" hidden>
  <div class="boon-figure" data-boon-figure>{{ boon('welcome', 'boon-pose is-on') }}{{ boon('offering', 'boon-pose') }}{{ boon('success', 'boon-pose') }}{{ boon('goodbye', 'boon-pose') }}</div>
  <div class="boon-note-copy">
    <p class="mono">Khun Boon · your concierge</p>
    <h2 id="boon-note-title" data-boon-title>Sawasdee. The only cookies here are the edible kind.</h2>
    <p id="boon-note-text" data-boon-text>No tracking and no advertising on this website. May I offer you a coconut sweet while you look around?</p>
    <div class="boon-actions" data-boon-actions><button class="button" type="button" data-boon-yes><span>Yes, please</span></button><button class="boon-later" type="button" data-boon-no>Not today</button></div>
    <a class="text-arrow" href="{{ url('tools/visa-finder/') }}" data-boon-next hidden>Find my starting point {{ icon('arrow') }}</a>
  </div>
  <button class="boon-close" type="button" aria-label="Close" data-boon-close><span aria-hidden="true"></span></button>
</aside>
